{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/b/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev: optimised, godot-cpp template_debug (day-to-day)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "GODOTCPP_TARGET": "template_debug", "OPENBF3_BUILD_CHECKS": "ON" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "debug: unoptimised (/MTd), godot-cpp template_debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "GODOTCPP_TARGET": "template_debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release: optimised, godot-cpp template_release (shipping)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "GODOTCPP_TARGET": "template_release", "OPENBF3_BUILD_CHECKS": "OFF" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "asan: optimised + /fsanitize=address, tests and tools only (no GDExtension)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "OPENBF3_ASAN": "ON", "OPENBF3_BUILD_GODOT": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    { "name": "test-base", "hidden": true, "output": { "outputOnFailure": true } },
    {
      "name": "branch-base",
      "hidden": true,
      "inherits": "test-base",
      "execution": { "jobs": 16 },
      "filter": { "exclude": { "label": "^(timing|realtime|window)$" } }
    },
    { "name": "dev", "inherits": "branch-base", "configurePreset": "dev",
      "displayName": "dev: the branch pass (docs/testing.md; no timing, realtime or window rows), 16 jobs" },
    { "name": "debug", "inherits": "branch-base", "configurePreset": "debug" },
    { "name": "release", "inherits": "branch-base", "configurePreset": "release" },
    {
      "name": "dev-realtime",
      "inherits": "test-base",
      "configurePreset": "dev",
      "displayName": "dev-realtime: the merge pass's real-time lane (label realtime), 8 jobs",
      "execution": { "jobs": 8 },
      "filter": { "include": { "label": "^realtime$" } }
    },
    {
      "name": "dev-timing",
      "inherits": "test-base",
      "configurePreset": "dev",
      "displayName": "dev-timing: the merge pass's timing rows and memory gates (labels timing, merge_also), serial",
      "execution": { "jobs": 1 },
      "filter": { "include": { "label": "^(timing|merge_also)$" } },
      "environment": { "OPENBF3_CL_TIMING": "1", "OPENBF3_CL_LOOPBACK_S": "60" }
    },
    {
      "name": "dev-window",
      "inherits": "test-base",
      "configurePreset": "dev",
      "displayName": "dev-window: the windowed Godot rows (label window), serial, the user-away tenure only",
      "execution": { "jobs": 1 },
      "filter": { "include": { "label": "^window$" }, "exclude": { "label": "^retired$" } }
    },
    {
      "name": "asan",
      "inherits": "test-base",
      "configurePreset": "asan",
      "displayName": "asan: the default asan selection (no asan_sweep, realtime or window rows), 16 jobs",
      "execution": { "jobs": 16 },
      "filter": { "exclude": { "label": "^(asan_sweep|realtime|window)$" } }
    },
    {
      "name": "asan-realtime",
      "inherits": "test-base",
      "configurePreset": "asan",
      "displayName": "asan-realtime: the real-time rows under asan (label realtime), 4 jobs, after the asan phase",
      "execution": { "jobs": 4 },
      "filter": { "include": { "label": "^realtime$" }, "exclude": { "label": "^asan_sweep$" } }
    },
    {
      "name": "asan-sweep",
      "inherits": "test-base",
      "configurePreset": "asan",
      "displayName": "asan-sweep: the full tier's sweeps (label asan_sweep, asan wall above 600 s), 8 jobs",
      "execution": { "jobs": 8 },
      "filter": { "include": { "label": "^asan_sweep$" } }
    }
  ]
}
