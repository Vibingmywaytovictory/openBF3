; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="bf3-opensource"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[gui]

common/auto_focus_strategy=1

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/multi_bounce_occlusion/enabled=true

[threading]

; M1 T6 (docs/design/m1.md §3): Godot's pool capped at 4 so it does not compete with the server, client and loader
; threads; the level upload keeps at most 3 C1 tasks in flight, so one pool thread stays free.
worker_pool/max_threads=4

; M2a audio (docs/design/m2a-audio.md §6.5): the server mixes at the data rate (AudioSystemAsset SampleRate), so the
; openBF3 mixer stream is never resampled.
[audio]

driver/mix_rate=48000
