# The merge pass's timing phases (docs/testing.md; tools\build.cmd --timing / --phase runs this).
#   cmake -DPRESET=dev -DBDIR=<build dir> -DPHASES=<realtime;timing;window> [-DSTRICT=1] [-DRERUN_LOG=<file>]
#         -P tools/timing_pass.cmake
# Each phase is one ctest call of its test preset (<PRESET>-realtime -j8, <PRESET>-timing serial, <PRESET>-window
# serial) with --output-junit b/<preset>/ctest-<preset>-<phase>.xml, then tools/test_budget.cmake on it. Every phase
# runs even when an earlier one failed; the script exits 1 if any failed.
# The realtime phase's rerun rule (tests/realtime_retry.cmake): a failed lane row is rerun alone only when every
# failing line of its output matches the row's real-time checks; a crash, a timeout, a missing summary or any other
# failing line fails at once. Both results are printed. With RERUN_LOG every realtime phase appends one
# <date> <commit> - lane line (so the log holds every lane run, clean or not) and every "lane fail, alone pass" a
# <date> <commit> <row> <check> line (tab-separated); the pass fails when the same check needed a rerun on 2 of the
# last 5 commits whose lane ran (the last 5 merges).
# A phase that selects no row fails (a label or preset filter that went wrong must not pass silently). With
# REQUIRE_RUN=1 (or the environment variable OPENBF3_TIMING_REQUIRE_RUN=1; the main-merge workflow sets it) a row
# that skipped (exit 77: no Godot exe, no OPENBF3_GODOT_WINDOWED, the user-active flag) also fails its phase: on main
# every merge-pass row has to run, while a branch's --all-tests may skip the windowed rows.
# The quiet lock, the settle and the user-away wait belong to the caller (the main-merge workflow), never to this
# script: it never creates, waits on or deletes the lock.
cmake_minimum_required(VERSION 3.29)
if(NOT DEFINED PRESET)
	set(PRESET dev)
endif()
if(NOT DEFINED PHASES)
	set(PHASES realtime timing window)
endif()
if(NOT DEFINED STRICT)
	set(STRICT 0)
endif()
if(NOT DEFINED REQUIRE_RUN)
	set(REQUIRE_RUN "$ENV{OPENBF3_TIMING_REQUIRE_RUN}")
endif()
if(NOT REQUIRE_RUN STREQUAL "1")
	set(REQUIRE_RUN 0)
endif()
get_filename_component(_tools "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
get_filename_component(_root "${_tools}/.." ABSOLUTE)
get_filename_component(_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(_ctest NAMES ctest HINTS "${_bin}" NO_DEFAULT_PATH)
include("${_root}/tests/realtime_retry.cmake")

function(xml_unescape p_text r_out)
	string(REPLACE "&lt;" "<" t "${p_text}")
	string(REPLACE "&gt;" ">" t "${t}")
	string(REPLACE "&quot;" "\"" t "${t}")
	string(REPLACE "&apos;" "'" t "${t}")
	string(REPLACE "&amp;" "&" t "${t}")
	set(${r_out} "${t}" PARENT_SCOPE)
endfunction()

# Runs one phase; sets r_rc (0 when it passed), r_ran (1 when it selected at least one row) and r_hard (1 when it
# failed in a way no rerun can clear: no row selected, a skipped row under REQUIRE_RUN, a budget violation).
function(run_phase p_phase r_rc r_ran r_hard)
	set(hard 0)
	set(junit "${BDIR}/ctest-${PRESET}-${p_phase}.xml")
	file(REMOVE "${junit}")
	message("timing_pass: phase ${p_phase}: ctest --preset ${PRESET}-${p_phase}")
	execute_process(COMMAND "${_ctest}" --preset ${PRESET}-${p_phase} --output-junit "${junit}" ${ARGN}
		WORKING_DIRECTORY "${_root}" RESULT_VARIABLE rc)
	if(EXISTS "${junit}")
		execute_process(COMMAND "${CMAKE_COMMAND}" "-DJUNIT=${junit}" "-DTESTDIR=${BDIR}" -DSTRICT=${STRICT}
			-DPHASE=${PRESET}-${p_phase} -P "${_tools}/test_budget.cmake" RESULT_VARIABLE brc)
		if(NOT brc EQUAL 0)
			set(rc 1)
			set(hard 1)
		endif()
		file(READ "${junit}" xml)
		string(REGEX MATCHALL "<testcase name=\"[^\"]*\"" all "${xml}")
		list(LENGTH all n_rows)
		string(REGEX MATCHALL "<testcase name=\"[^\"]*\"[^>]*status=\"(notrun|disabled)\"" skipped "${xml}")
		set(skipped_names "")
		foreach(h IN LISTS skipped)
			string(REGEX MATCH "name=\"([^\"]*)\"" _ "${h}")
			list(APPEND skipped_names "${CMAKE_MATCH_1}")
		endforeach()
	else()
		set(n_rows 0)
		set(skipped_names "")
	endif()
	set(${r_ran} 0 PARENT_SCOPE)
	if(n_rows EQUAL 0)
		message("timing_pass: phase ${p_phase} selected no row: FAIL (check the labels and the ${PRESET}-${p_phase} preset)")
		set(rc 1)
		set(hard 1)
	else()
		set(${r_ran} 1 PARENT_SCOPE)
	endif()
	if(NOT skipped_names STREQUAL "")
		string(REPLACE ";" " " t "${skipped_names}")
		if(REQUIRE_RUN)
			message("timing_pass: phase ${p_phase}: skipped rows with REQUIRE_RUN=1: FAIL: ${t}")
			set(rc 1)
			set(hard 1)
		else()
			message("timing_pass: phase ${p_phase}: skipped rows (allowed without REQUIRE_RUN): ${t}")
		endif()
	endif()
	set(${r_rc} ${rc} PARENT_SCOPE)
	set(${r_hard} ${hard} PARENT_SCOPE)
endfunction()

# The failed rows of a junit file, each as "<row>|<failure message>".
function(failed_rows p_junit r_rows)
	file(READ "${p_junit}" xml)
	string(REGEX MATCHALL "<testcase name=\"[^\"]*\"[^>]*status=\"fail\"[^>]*>[ \t\r\n]*<failure message=\"[^\"]*\"" hits "${xml}")
	set(rows "")
	foreach(h IN LISTS hits)
		string(REGEX MATCH "name=\"([^\"]*)\"" _ "${h}")
		set(n "${CMAKE_MATCH_1}")
		string(REGEX MATCH "<failure message=\"([^\"]*)\"" _ "${h}")
		list(APPEND rows "${n}|${CMAKE_MATCH_1}")
	endforeach()
	set(${r_rows} "${rows}" PARENT_SCOPE)
endfunction()

# Decides whether a failed lane row may be rerun alone. r_ok: TRUE/FALSE; r_checks: the failing lines (';'-joined
# names, for the log); r_why: the reason when not.
function(rerun_allowed p_junit p_row p_message r_ok r_checks r_why)
	set(${r_ok} FALSE PARENT_SCOPE)
	set(${r_checks} "" PARENT_SCOPE)
	if(NOT p_row IN_LIST RT_ROWS)
		set(${r_why} "not a listed real-time row" PARENT_SCOPE)
		return()
	endif()
	if(NOT p_message STREQUAL "Failed")
		set(${r_why} "ctest says '${p_message}' (crash or timeout)" PARENT_SCOPE)
		return()
	endif()
	file(READ "${p_junit}" xml)
	string(FIND "${xml}" "<testcase name=\"${p_row}\"" at)
	string(SUBSTRING "${xml}" ${at} -1 rest)
	string(FIND "${rest}" "</testcase>" end)
	string(SUBSTRING "${rest}" 0 ${end} body)
	string(FIND "${body}" "<system-out>" out_at)
	if(out_at EQUAL -1)
		set(${r_why} "no output in the junit file" PARENT_SCOPE)
		return()
	endif()
	math(EXPR out_at "${out_at} + 12")
	string(SUBSTRING "${body}" ${out_at} -1 body)
	string(REPLACE "</system-out>" "" body "${body}")
	xml_unescape("${body}" body)
	if(NOT body MATCHES "${RT_${p_row}_SUMMARY}")
		set(${r_why} "no summary line (crash, early exit or truncated output)" PARENT_SCOPE)
		return()
	endif()
	string(REPLACE ";" "," body "${body}")
	string(REPLACE "\r" "" body "${body}")
	string(REPLACE "\n" ";" lines "${body}")
	set(checks "")
	foreach(line IN LISTS lines)
		if(NOT line MATCHES "${RT_${p_row}_FAIL}")
			continue()
		endif()
		if(NOT line MATCHES "${RT_${p_row}_RETRY}")
			set(${r_why} "a failing line that is not a real-time check: ${line}" PARENT_SCOPE)
			return()
		endif()
		if(NOT "${RT_${p_row}_NO_RETRY}" STREQUAL "" AND line MATCHES "${RT_${p_row}_NO_RETRY}")
			set(${r_why} "a functional failure of a real-time check: ${line}" PARENT_SCOPE)
			return()
		endif()
		string(REGEX MATCH "${RT_${p_row}_RETRY}" name "${line}")
		string(STRIP "${name}" name)
		string(REPLACE " " "_" name "${name}")
		list(APPEND checks "${name}")
	endforeach()
	if(checks STREQUAL "")
		set(${r_why} "no failing check line" PARENT_SCOPE)
		return()
	endif()
	list(REMOVE_DUPLICATES checks)
	set(${r_ok} TRUE PARENT_SCOPE)
	set(${r_checks} "${checks}" PARENT_SCOPE)
	set(${r_why} "" PARENT_SCOPE)
endfunction()

# Replay mode (-DREPLAY_JUNIT=<realtime junit>): print the rerun decision for every failed row of that file, run nothing.
if(DEFINED REPLAY_JUNIT)
	failed_rows("${REPLAY_JUNIT}" rows)
	foreach(entry IN LISTS rows)
		string(REGEX MATCH "^([^|]*)\\|(.*)$" _ "${entry}")
		rerun_allowed("${REPLAY_JUNIT}" "${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}" ok checks why)
		string(REPLACE ";" " " checks "${checks}")
		message("replay: ${CMAKE_MATCH_1}: rerun ${ok} ${checks}${why}")
	endforeach()
	return()
endif()

set(pass_failed FALSE)
set(logged "")
execute_process(COMMAND git -C "${_root}" rev-parse --short HEAD OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
foreach(phase IN LISTS PHASES)
	run_phase(${phase} rc ran hard)
	if(hard EQUAL 1)
		set(pass_failed TRUE)
	endif()
	if(phase STREQUAL "realtime" AND ran EQUAL 1)
		if(DEFINED RERUN_LOG AND NOT RERUN_LOG STREQUAL "")
			string(TIMESTAMP now "%Y-%m-%dT%H:%M:%S")
			file(APPEND "${RERUN_LOG}" "${now}\t${commit}\t-\tlane\n")
		endif()
	endif()
	if(rc EQUAL 0)
		continue()
	endif()
	set(junit "${BDIR}/ctest-${PRESET}-${phase}.xml")
	if(NOT phase STREQUAL "realtime" OR NOT EXISTS "${junit}")
		set(pass_failed TRUE)
		continue()
	endif()
	failed_rows("${junit}" rows)
	if(rows STREQUAL "")
		message("timing_pass: realtime phase failed without a failed row (budget violation or ctest error)")
		set(pass_failed TRUE)
		continue()
	endif()
	foreach(entry IN LISTS rows)
		string(REGEX MATCH "^([^|]*)\\|(.*)$" _ "${entry}")
		set(row "${CMAKE_MATCH_1}")
		set(msg "${CMAKE_MATCH_2}")
		rerun_allowed("${junit}" "${row}" "${msg}" ok checks why)
		if(NOT ok)
			message("timing_pass: ${row} failed in the lane, no rerun: ${why}")
			set(pass_failed TRUE)
			continue()
		endif()
		string(REPLACE ";" " " checks_text "${checks}")
		message("timing_pass: ${row} failed in the lane on real-time checks only (${checks_text}); rerunning it alone")
		set(rerun_junit "${BDIR}/ctest-${PRESET}-realtime-rerun-${row}.xml")
		execute_process(COMMAND "${_ctest}" --preset ${PRESET}-realtime -R "^${row}$" -j1 --output-junit "${rerun_junit}"
			WORKING_DIRECTORY "${_root}" RESULT_VARIABLE rrc)
		if(NOT rrc EQUAL 0)
			message("timing_pass: ${row}: lane FAIL, alone FAIL")
			set(pass_failed TRUE)
			continue()
		endif()
		message("timing_pass: ${row}: lane FAIL, alone PASS (counted as a rerun)")
		if(DEFINED RERUN_LOG AND NOT RERUN_LOG STREQUAL "")
			string(TIMESTAMP now "%Y-%m-%dT%H:%M:%S")
			foreach(c IN LISTS checks)
				file(APPEND "${RERUN_LOG}" "${now}\t${commit}\t${row}\t${c}\n")
				list(APPEND logged "${row}\t${c}")
			endforeach()
		endif()
	endforeach()
endforeach()

# A check that keeps needing reruns is a regression hiding behind them: 2 of the last 5 commits whose lane ran (every
# lane run logs a "- lane" line, so these are the last 5 merges) fail.
if(NOT logged STREQUAL "" AND EXISTS "${RERUN_LOG}")
	file(STRINGS "${RERUN_LOG}" log_lines)
	set(commits "")
	foreach(l IN LISTS log_lines)
		string(REPLACE "\t" ";" f "${l}")
		list(GET f 1 c)
		if(NOT c IN_LIST commits)
			list(APPEND commits "${c}")
		endif()
	endforeach()
	list(LENGTH commits nc)
	set(first 0)
	if(nc GREATER 5)
		math(EXPR first "${nc} - 5")
	endif()
	list(SUBLIST commits ${first} 5 recent)
	foreach(key IN LISTS logged)
		set(hits "")
		foreach(l IN LISTS log_lines)
			string(REPLACE "\t" ";" f "${l}")
			list(GET f 1 c)
			list(GET f 2 r)
			list(GET f 3 k)
			if("${r}\t${k}" STREQUAL "${key}" AND c IN_LIST recent AND NOT c IN_LIST hits)
				list(APPEND hits "${c}")
			endif()
		endforeach()
		list(LENGTH hits nh)
		if(nh GREATER_EQUAL 2)
			string(REPLACE "\t" " " k "${key}")
			list(LENGTH recent nr)
			message("timing_pass: ${k} needed a rerun on ${nh} of the last ${nr} lane runs: investigate; the pass fails")
			set(pass_failed TRUE)
		endif()
	endforeach()
endif()

if(pass_failed)
	message("timing_pass: FAIL")
	cmake_language(EXIT 1)
endif()
message("timing_pass: PASS")
