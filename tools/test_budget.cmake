# Test budget report (docs/testing.md): the slowest rows of one ctest phase, the skipped rows and every budget or
# label violation of the policy. build.cmd runs it after each ctest phase.
#   cmake -DJUNIT=<ctest --output-junit file> -DTESTDIR=<build dir> [-DSTRICT=1] [-DASAN=1] [-DPHASE=<name>]
#         -P tools/test_budget.cmake
# JUNIT gives each row's wall time and result; `ctest --test-dir <TESTDIR> --show-only=json-v1` gives the LABELS,
# RUN_SERIAL, PROCESSORS, COST and RESOURCE_LOCK properties (a scheduling reason is a label because the JSON carries
# no CMake comments). Prints only; with STRICT=1 a violation makes it exit 1. Junit times are wall times, so a row
# measured in a parallel phase reads slower than alone (the budgets are for a row alone on a quiet machine); CPU
# seconds need a Job Object harness (docs/testing.md "Measuring").
cmake_minimum_required(VERSION 3.29)
if(NOT DEFINED JUNIT OR NOT EXISTS "${JUNIT}")
	message(FATAL_ERROR "test_budget: -DJUNIT=<file> is required (got '${JUNIT}')")
endif()
if(NOT DEFINED TESTDIR OR NOT IS_DIRECTORY "${TESTDIR}")
	message(FATAL_ERROR "test_budget: -DTESTDIR=<build dir> is required (got '${TESTDIR}')")
endif()
if(NOT DEFINED PHASE)
	set(PHASE "ctest")
endif()
get_filename_component(_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(_ctest NAMES ctest HINTS "${_bin}" NO_DEFAULT_PATH)
if(NOT _ctest)
	find_program(_ctest NAMES ctest)
endif()

# Rows whose length the gate defines (docs/testing.md budget 4): exempt from the 120 s timing / realtime / window cap.
set(gate_length_rows godot.m1 godot.m1.e1 godot.m1.e2_gate godot.m1.e2_stress host.session host.session.gate
	host.session.stress godot.s3_crowd godot.l1_look host.scale.paced)
# The one dev row allowed past 60 s (docs/testing.md budget 4).
set(long_dev_rows sim.terrain)
set(serial_reasons timing realtime window bigmem serial_wallclock)
set(scheduling_labels timing realtime window)

# Seconds text ("12.345") to integer milliseconds.
function(seconds_to_ms p_text r_ms)
	if(p_text MATCHES "^([0-9]+)(\\.([0-9]*))?")
		set(whole "${CMAKE_MATCH_1}")
		set(frac "${CMAKE_MATCH_3}000")
		string(SUBSTRING "${frac}" 0 3 frac)
		string(REGEX REPLACE "^0+([0-9])" "\\1" frac "${frac}")
		math(EXPR ms "${whole} * 1000 + ${frac}")
	else()
		set(ms 0)
	endif()
	set(${r_ms} ${ms} PARENT_SCOPE)
endfunction()

function(ms_to_text p_ms r_text)
	math(EXPR whole "${p_ms} / 1000")
	math(EXPR tenth "(${p_ms} % 1000) / 100")
	set(${r_text} "${whole}.${tenth}" PARENT_SCOPE)
endfunction()

# Properties of every registered row.
execute_process(COMMAND "${_ctest}" --test-dir "${TESTDIR}" --show-only=json-v1
	OUTPUT_VARIABLE json RESULT_VARIABLE json_rc ERROR_QUIET)
if(NOT json_rc EQUAL 0)
	message(FATAL_ERROR "test_budget: ctest --show-only=json-v1 failed (${json_rc})")
endif()
string(JSON test_count LENGTH "${json}" tests)
math(EXPR last "${test_count} - 1")
foreach(i RANGE 0 ${last})
	string(JSON name GET "${json}" tests ${i} name)
	string(JSON prop_count ERROR_VARIABLE prop_err LENGTH "${json}" tests ${i} properties)
	if(prop_err)
		continue()
	endif()
	set(P_${name}_LABELS "")
	set(P_${name}_RUN_SERIAL FALSE)
	set(P_${name}_PROCESSORS 1)
	set(P_${name}_COST "")
	if(prop_count GREATER 0)
		math(EXPR plast "${prop_count} - 1")
		foreach(j RANGE 0 ${plast})
			string(JSON pname GET "${json}" tests ${i} properties ${j} name)
			if(pname STREQUAL "LABELS")
				string(JSON nl LENGTH "${json}" tests ${i} properties ${j} value)
				math(EXPR nlast "${nl} - 1")
				foreach(k RANGE 0 ${nlast})
					string(JSON l GET "${json}" tests ${i} properties ${j} value ${k})
					list(APPEND P_${name}_LABELS "${l}")
				endforeach()
			elseif(pname STREQUAL "RUN_SERIAL" OR pname STREQUAL "PROCESSORS" OR pname STREQUAL "COST")
				string(JSON v GET "${json}" tests ${i} properties ${j} value)
				set(P_${name}_${pname} "${v}")
			endif()
		endforeach()
	endif()
	set(P_${name}_KNOWN TRUE)
endforeach()

# Rows of this phase.
file(READ "${JUNIT}" xml)
set(suite_ms 0)
if(xml MATCHES "<testsuite[^>]*[ \t\r\n]time=\"([0-9.]+)\"")
	seconds_to_ms("${CMAKE_MATCH_1}" suite_ms)
endif()
string(REGEX MATCHALL "<testcase [^>]*>" cases "${xml}")
set(sorted "")
set(skipped "")
set(failed "")
set(violations "")
set(warnings "")
set(cap_overs "")
set(sum_ms 0)
set(cpu_ms 0)
set(ran 0)
foreach(c IN LISTS cases)
	string(REGEX MATCH "name=\"([^\"]*)\"" _ "${c}")
	set(name "${CMAKE_MATCH_1}")
	string(REGEX MATCH "time=\"([^\"]*)\"" _ "${c}")
	seconds_to_ms("${CMAKE_MATCH_1}" ms)
	string(REGEX MATCH "status=\"([^\"]*)\"" _ "${c}")
	set(status "${CMAKE_MATCH_1}")
	if(status STREQUAL "notrun" OR status STREQUAL "disabled")
		list(APPEND skipped "${name}")
		continue()
	endif()
	if(status STREQUAL "fail")
		list(APPEND failed "${name}")
	endif()
	math(EXPR ran "${ran} + 1")
	math(EXPR sum_ms "${sum_ms} + ${ms}")
	set(procs "${P_${name}_PROCESSORS}")
	if(procs STREQUAL "")
		set(procs 1)
	endif()
	math(EXPR cpu_ms "${cpu_ms} + ${ms} * ${procs}")
	math(EXPR key "100000000 + ${ms}")
	list(APPEND sorted "${key}|${name}")

	set(labels "${P_${name}_LABELS}")
	set(sched "")
	foreach(l IN LISTS labels)
		if(l IN_LIST scheduling_labels)
			list(APPEND sched "${l}")
		endif()
	endforeach()
	list(LENGTH sched nsched)
	if(nsched GREATER 1)
		list(APPEND violations "${name}: more than one scheduling label (${sched})")
	endif()
	if(P_${name}_RUN_SERIAL)
		set(reason FALSE)
		foreach(l IN LISTS labels)
			if(l IN_LIST serial_reasons)
				set(reason TRUE)
			endif()
		endforeach()
		if(NOT reason)
			list(APPEND violations "${name}: RUN_SERIAL without a timing / realtime / window / bigmem / serial_wallclock label")
		endif()
	endif()
	ms_to_text(${ms} t)
	if(ms GREATER 30000 AND "${P_${name}_COST}" STREQUAL "")
		list(APPEND violations "${name}: ${t} s without COST")
	endif()
	if(name MATCHES "\\.split_cover$" AND status STREQUAL "fail")
		list(APPEND violations "${name}: split rows do not cover the suite")
	endif()
	# Time budgets (docs/testing.md 4). The 60 s dev cap is a violation in a serial phase (a parallel phase inflates
	# row walls, so there it warns); the others warn.
	if(ASAN)
		if(ms GREATER 600000 AND NOT "asan_sweep" IN_LIST labels)
			list(APPEND warnings "${name}: ${t} s under asan without the asan_sweep label")
		endif()
	elseif(nsched EQUAL 0)
		if(name IN_LIST long_dev_rows)
			set(cap 150000)
		else()
			set(cap 60000)
		endif()
		if(ms GREATER cap)
			list(APPEND cap_overs "${name}: ${t} s over the dev cap")
		elseif(name MATCHES "(\\.unit|contract)$" AND ms GREATER 2000)
			list(APPEND warnings "${name}: ${t} s over the 2 s data-free budget")
		elseif(ms GREATER 15000 AND NOT name IN_LIST long_dev_rows)
			list(APPEND warnings "${name}: ${t} s over the 15 s install-row budget")
		endif()
	elseif(ms GREATER 120000 AND NOT name IN_LIST gate_length_rows)
		list(APPEND warnings "${name}: ${t} s over the 120 s ${sched} budget")
	endif()
endforeach()

# A phase whose row walls sum to more than 1.1 x its wall ran rows in parallel.
math(EXPR parallel_test "${sum_ms} * 10 - ${suite_ms} * 11")
foreach(o IN LISTS cap_overs)
	if(parallel_test GREATER 0)
		list(APPEND warnings "${o} (parallel phase: time the row alone before acting)")
	else()
		list(APPEND violations "${o}")
	endif()
endforeach()
list(SORT sorted COMPARE NATURAL ORDER DESCENDING)
list(LENGTH cases total)
list(LENGTH skipped nskipped)
list(LENGTH failed nfailed)
message("== test budget: ${PHASE} (${JUNIT})")
message("rows ${total}: ran ${ran}, failed ${nfailed}, skipped ${nskipped}")
message("slowest rows (wall s | labels | PROCESSORS | PROCESSORS x wall s):")
set(shown 0)
foreach(entry IN LISTS sorted)
	if(shown EQUAL 15)
		break()
	endif()
	string(REGEX MATCH "^([0-9]+)\\|(.*)$" _ "${entry}")
	set(name "${CMAKE_MATCH_2}")
	math(EXPR ms "${CMAKE_MATCH_1} - 100000000")
	ms_to_text(${ms} t)
	set(procs "${P_${name}_PROCESSORS}")
	math(EXPR pms "${ms} * ${procs}")
	ms_to_text(${pms} pt)
	string(REPLACE ";" "," lab "${P_${name}_LABELS}")
	if(lab STREQUAL "")
		set(lab "-")
	endif()
	string(LENGTH "${name}" nlen)
	set(pad "")
	if(nlen LESS 28)
		math(EXPR npad "28 - ${nlen}")
		string(REPEAT " " ${npad} pad)
	endif()
	message("  ${name}${pad} ${t} | ${lab} | ${procs} | ${pt}")
	math(EXPR shown "${shown} + 1")
endforeach()
ms_to_text(${sum_ms} sum_t)
ms_to_text(${suite_ms} suite_t)
ms_to_text(${cpu_ms} cpu_t)
message("sum of row walls ${sum_t} s, phase wall ${suite_t} s, sum of PROCESSORS x wall ${cpu_t} s")
if(nskipped GREATER 0)
	string(REPLACE ";" " " sk "${skipped}")
	message("skipped (${nskipped}): ${sk}")
endif()
if(nfailed GREATER 0)
	string(REPLACE ";" " " fl "${failed}")
	message("failed (${nfailed}): ${fl}")
endif()
foreach(w IN LISTS warnings)
	message("budget warning: ${w}")
endforeach()
foreach(v IN LISTS violations)
	message("budget VIOLATION: ${v}")
endforeach()
list(LENGTH violations nviol)
if(nviol GREATER 0 AND STRICT)
	message("test_budget: ${nviol} violation(s) (STRICT)")
	cmake_language(EXIT 1)
endif()
