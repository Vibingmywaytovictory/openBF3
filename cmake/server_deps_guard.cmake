set(OPENBF3_SERVER_LIBRARIES bf3_host bf3_present bf3_sim bf3_net bf3_core bf3_anim bf3_ai)
set(OPENBF3_SERVER_EXTERN godot-cpp Jolt Recast Detour DetourCrowd enet libdeflate_static)
set_property(GLOBAL PROPERTY OPENBF3_SERVER_SET ${OPENBF3_SERVER_LIBRARIES} ${OPENBF3_SERVER_EXTERN})

function(openbf3_directory_targets p_dir r_targets)
    get_property(targets DIRECTORY "${p_dir}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(subdirs DIRECTORY "${p_dir}" PROPERTY SUBDIRECTORIES)
    foreach(sub IN LISTS subdirs)
        openbf3_directory_targets("${sub}" sub_targets)
        list(APPEND targets ${sub_targets})
    endforeach()
    set(${r_targets} ${targets} PARENT_SCOPE)
endfunction()

function(openbf3_link_closure p_target r_closure)
    set(seen "")
    set(queue ${p_target})
    while(queue)
        list(POP_FRONT queue item)
        if(item IN_LIST seen)
            continue()
        endif()
        list(APPEND seen ${item})
        get_target_property(type ${item} TYPE)
        set(properties INTERFACE_LINK_LIBRARIES)
        if(NOT type STREQUAL "INTERFACE_LIBRARY")
            list(APPEND properties LINK_LIBRARIES)
        endif()
        foreach(property IN LISTS properties)
            get_target_property(links ${item} ${property})
            if(NOT links)
                continue()
            endif()
            string(REGEX REPLACE "[$<>,]" ";" tokens "${links}")
            foreach(token IN LISTS tokens)
                string(REGEX REPLACE "^[A-Z_]+:" "" name "${token}")
                if(name STREQUAL "" OR NOT TARGET "${name}")
                    continue()
                endif()
                get_target_property(aliased "${name}" ALIASED_TARGET)
                if(aliased)
                    set(name ${aliased})
                endif()
                list(APPEND queue ${name})
            endforeach()
        endforeach()
    endwhile()
    list(REMOVE_ITEM seen ${p_target})
    set(${r_closure} ${seen} PARENT_SCOPE)
endfunction()

function(openbf3_server_deps_guard p_source)
    get_property(allowed GLOBAL PROPERTY OPENBF3_SERVER_SET)
    openbf3_directory_targets("${CMAKE_SOURCE_DIR}" targets)
    set(holders "")
    foreach(target IN LISTS targets)
        get_target_property(sources ${target} SOURCES)
        foreach(source IN LISTS sources)
            get_filename_component(name "${source}" NAME)
            if(name STREQUAL p_source)
                list(APPEND holders ${target})
                break()
            endif()
        endforeach()
    endforeach()
    if(NOT holders)
        message(FATAL_ERROR "build.server_deps: no target compiles ${p_source}, the dedicated server")
    endif()
    foreach(holder IN LISTS holders)
        openbf3_link_closure(${holder} closure)
        set(outside "")
        foreach(item IN LISTS closure)
            if(NOT item IN_LIST allowed)
                list(APPEND outside ${item})
            endif()
        endforeach()
        if(outside)
            list(JOIN outside ", " outside_text)
            list(JOIN allowed ", " allowed_text)
            message(FATAL_ERROR "build.server_deps: ${holder} compiles ${p_source}, the dedicated server, and links "
                "${outside_text}, outside the server's set (${allowed_text})")
        endif()
        list(JOIN closure ", " closure_text)
        message(STATUS "build.server_deps: ${holder} (${p_source}) links ${closure_text}")
    endforeach()
endfunction()
