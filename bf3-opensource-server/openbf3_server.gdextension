[configuration]

entry_symbol = "openbf3_server_library_init"
compatibility_minimum = "4.8"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/libopenbf3_server.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libopenbf3_server.windows.template_release.x86_64.dll"
