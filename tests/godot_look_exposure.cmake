cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(cache "${BUILD_DIR}/godot-cache/${ROW}")
file(MAKE_DIRECTORY "${cache}")
if("$ENV{OPENBF3_LOOK_SHOTS}" STREQUAL "")
    set(shots "${BUILD_DIR}/shots/${ROW}")
else()
    file(TO_CMAKE_PATH "$ENV{OPENBF3_LOOK_SHOTS}" shots)
endif()
file(MAKE_DIRECTORY "${shots}")

function(to_ten_thousandths value out)
    string(REGEX MATCH "^([0-9]+)\\.([0-9][0-9][0-9][0-9])$" ok "${value}")
    if(NOT ok)
        set(${out} -1 PARENT_SCOPE)
        return()
    endif()
    set(whole "${CMAKE_MATCH_1}")
    string(REGEX REPLACE "^0+([0-9])" "\\1" frac "${CMAKE_MATCH_2}")
    math(EXPR v "${whole} * 10000 + ${frac}")
    set(${out} ${v} PARENT_SCOPE)
endfunction()

set(failed FALSE)
set(views_MP_007 "caspian_us_hq@-94.8,148.2,733.6,158.8,-2;caspian_middle@-82.3,148.3,68.7,40.3,-4;caspian_ru_hq@287.4,174.8,-332.7,228.0,-2;caspian_above@0,260,200,180,-25")
set(views_MP_003 "tehran_spawn@-402.3,258.9,-278.9,265.8,0;tehran_street@-370.5,259.3,-412.5,318.9,-5")
foreach(level MP_007 MP_003)
    if(level STREQUAL "MP_007")
        set(mode ConquestSmall0)
    else()
        set(mode TeamDeathMatch0)
    endif()
    set(views "")
    foreach(view IN LISTS views_${level})
        list(APPEND views "${shots}/${view}")
    endforeach()
    string(REPLACE "@" ".png@" views "${views}")
    string(REPLACE ";" "\\;" views "${views}")
    godot_run(QUIET SKIP_WITHOUT_INSTALL TIMEOUT 300
        ARGS --resolution 1280x720 --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn -- "--level=${level}" "--mode=${mode}"
            --bots=0 --deploy-screen=0 --no-hud "--bf3-cache=${cache}" --shot-settle=3 "--shots=${views}")
    string(REPLACE ";" "," text "${out}")
    string(REGEX MATCHALL "\\[m1\\] shot look L1:[^\n]*" looks "${text}")
    list(LENGTH looks n)
    list(LENGTH views_${level} want)
    if(NOT rc STREQUAL "0" OR NOT n EQUAL want)
        message("${out}")
        message("${err}")
        message("godot.look.exposure: ${level} exited ${rc} with ${n} of ${want} look lines")
        set(failed TRUE)
        continue()
    endif()
    foreach(line IN LISTS looks)
        string(REGEX MATCH "middle grey ([0-9.]+) exposure [0-9.]+ \\(([0-9.]+)\\.\\.([0-9.]+)\\) over ([0-9.]+) s, tonemap ([A-Za-z]+),.*, measured exposure ([0-9.]+) at luminance ([0-9.]+) after ([0-9]+) frames, the rule's target ([0-9.]+)" m "${line}")
        if(NOT m)
            message("godot.look.exposure: ${level}: no measured exposure in '${line}'")
            set(failed TRUE)
            continue()
        endif()
        set(range "${CMAKE_MATCH_2}..${CMAKE_MATCH_3}")
        set(tonemap "${CMAKE_MATCH_5}")
        set(measured "${CMAKE_MATCH_6}")
        set(luminance "${CMAKE_MATCH_7}")
        set(frames "${CMAKE_MATCH_8}")
        set(target "${CMAKE_MATCH_9}")
        to_ten_thousandths("${measured}" e)
        to_ten_thousandths("${target}" t)
        message("${level}: tonemap ${tonemap}, middle grey ${CMAKE_MATCH_1}, range ${range} over ${CMAKE_MATCH_4} s; measured exposure ${measured} at luminance ${luminance} after ${frames} frames, rule ${target}")
        if(e LESS 0 OR t LESS_EQUAL 0)
            message("godot.look.exposure: ${level}: unreadable exposure '${measured}' or target '${target}'")
            set(failed TRUE)
            continue()
        endif()
        math(EXPR d "${e} - ${t}")
        if(d LESS 0)
            math(EXPR d "0 - ${d}")
        endif()
        math(EXPR limit "${t} / 200 + 1")
        if(d GREATER limit OR frames LESS 60)
            message("godot.look.exposure: ${level}: the GPU exposure ${measured} is not the rule's ${target} for its measured luminance (limit ${limit} ten-thousandths, after ${frames} frames)")
            set(failed TRUE)
        endif()
    endforeach()
    string(REGEX MATCH "\\[level\\] install unchanged: yes" unchanged "${text}")
    if(NOT unchanged)
        message("godot.look.exposure: ${level}: the install changed or the run did not say")
        set(failed TRUE)
    endif()
endforeach()
if(failed)
    message(FATAL_ERROR "godot.look.exposure: FAIL")
endif()
message("godot.look.exposure: PASS (shots in ${shots})")
