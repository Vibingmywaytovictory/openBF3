cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
if(NOT DEFINED SCENE OR SCENE STREQUAL "")
    set(SCENE "res://scenes/m1_metro.tscn")
endif()
separate_arguments(user_args NATIVE_COMMAND "${USER_ARGS}")
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef tag)
openbf3_scratch_dir(scratch godot-m1-load)
set(root "${scratch}/cache")
set(shots "${BUILD_DIR}/shots/m1_load-${tag}")
file(REMOVE_RECURSE "${shots}")
file(MAKE_DIRECTORY "${shots}")
message("shots directory: ${shots}")
set(failed FALSE)
foreach(pass cold warm)
    godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 140 HEADER ${pass} REMOVE_ON_SKIP "${root}"
        ARGS --path "${PROJECT_DIR}" "${SCENE}" -- "--m1-load-check=${pass}" "--bf3-cache=${root}"
            --shot-spawns=0,13,26,39,52,65,78,91 "--shot-dir=${shots}/${pass}" ${user_args})
    if(NOT rc STREQUAL "0" OR NOT out MATCHES "M1 LOAD CHECK: PASS")
        message("${ROW} ${pass} run failed (exit ${rc})")
        set(failed TRUE)
    endif()
    if(NOT out MATCHES "\\[level\\] view distance ([0-9]+) m at the first-person camera and ([0-9]+) m at the free camera; the diagonal of what the level draws ([0-9]+) m")
        message("${ROW} ${pass}: no view distance line")
        set(failed TRUE)
    elseif(NOT CMAKE_MATCH_1 EQUAL 2000 OR NOT CMAKE_MATCH_2 EQUAL 2000 OR NOT CMAKE_MATCH_3 GREATER 2000)
        message("${ROW} ${pass}: the cameras' far planes are ${CMAKE_MATCH_1} and ${CMAKE_MATCH_2} m with the drawn diagonal ${CMAKE_MATCH_3} m, not Metro park's ViewDistance of 2000 m")
        set(failed TRUE)
    endif()
    if(NOT out MATCHES "\\[level\\] terrain surface decals: 2 of 2 records drawn, 1 of 1 shaders, 22 triangles[\r\n]")
        message("${ROW} ${pass}: Metro's tree gratings (its surface decals) are not drawn")
        set(failed TRUE)
    endif()
endforeach()
openbf3_scratch_remove_all()
if("$ENV{OPENBF3_KEEP_SHOTS}" STREQUAL "")
    file(REMOVE_RECURSE "${shots}")
    message("shots removed (set OPENBF3_KEEP_SHOTS=1 to keep them in ${shots})")
else()
    message("shots: ${shots}/cold, ${shots}/warm")
endif()
if(failed)
    message(FATAL_ERROR "${ROW} failed")
endif()
