cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)

godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 200 ARGS ${godot_log_args} --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn --
    --level=MP_007 --mode=ConquestLarge0 --bots=0 --preround=0 --quit-after=5 ${godot_cache_args})

set(failures "")
if(NOT out MATCHES "\\[level\\] view distance ([0-9]+) m")
    string(APPEND failures " no-view-distance")
elseif(CMAKE_MATCH_1 LESS 8100)
    string(APPEND failures " view-distance-${CMAKE_MATCH_1}-short-of-the-backdrop")
endif()
if(NOT out MATCHES "\\[level\\] terrain decals: 281 of 281 records drawn, 5 of 5 shaders[\r\n]")
    string(APPEND failures " terrain-decals")
endif()
if(NOT out MATCHES "\\[level\\] terrain water: 42 of 42 records drawn, 1 of 1 shaders, 648 triangles[\r\n]")
    string(APPEND failures " terrain-water")
endif()
if(NOT out MATCHES "\\[game\\] placed effects: 338 placed, 239 start at load, ([0-9]+) of them started")
    string(APPEND failures " no-placed-effects-line")
elseif(CMAKE_MATCH_1 EQUAL 0)
    string(APPEND failures " no-placed-effect-started")
endif()
if(NOT out MATCHES "\\[game\\] fx: effects census: [0-9]+ of [0-9]+ blueprints compiled, emitters [^\r\n]* ParticleMesh ([0-9]+) [^\r\n]*, ([0-9]+) ParticleMesh emitters with their mesh loaded")
    string(APPEND failures " no-effects-census")
elseif(NOT CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2 OR CMAKE_MATCH_1 EQUAL 0)
    string(APPEND failures " mesh-emitters-${CMAKE_MATCH_2}-of-${CMAKE_MATCH_1}-loaded")
endif()
if(NOT out MATCHES "\\[game\\] effect lights: [^\r\n]*; mesh particles ([0-9]+) drawn, ([0-9]+) without a mesh;")
    string(APPEND failures " no-mesh-particle-counts")
elseif(CMAKE_MATCH_1 EQUAL 0 OR NOT CMAKE_MATCH_2 EQUAL 0)
    string(APPEND failures " mesh-particles-${CMAKE_MATCH_1}-drawn-${CMAKE_MATCH_2}-without-a-mesh")
endif()
if(NOT out MATCHES "\\[game\\] placed effects: 338 placed, [^\r\n]*, 0 mesh emitters not drawn")
    string(APPEND failures " placed-mesh-emitters-not-drawn")
endif()
if(NOT out MATCHES "\\[audio\\] impact and effect sounds: [0-9]+ impacts, ([0-9]+) effect sounds started, [0-9]+ stopped, ([0-9]+) unknown patches")
    string(APPEND failures " no-effect-sounds-line")
elseif(CMAKE_MATCH_1 EQUAL 0 OR NOT CMAKE_MATCH_2 EQUAL 0)
    string(APPEND failures " effect-sounds-${CMAKE_MATCH_1}-started-${CMAKE_MATCH_2}-unknown")
endif()
if(NOT out MATCHES "\\[game\\] effect particles by type: [^\r\n]*; ([0-9]+) particles not drawn, ([0-9]+) of a type without a drawer, [0-9]+ in the opaque pass; mesh particles ([0-9]+) drawn of ([0-9]+) instances")
    string(APPEND failures " no-particles-by-type")
else()
    message("${ROW}: ${CMAKE_MATCH_1} particles not drawn, ${CMAKE_MATCH_2} of a type without a drawer, mesh particles ${CMAKE_MATCH_3} drawn of ${CMAKE_MATCH_4}")
    if(NOT CMAKE_MATCH_1 EQUAL 0 OR NOT CMAKE_MATCH_2 EQUAL 0 OR CMAKE_MATCH_4 EQUAL 0 OR NOT CMAKE_MATCH_3 EQUAL CMAKE_MATCH_4)
        string(APPEND failures " particles-undrawn-${CMAKE_MATCH_1}-no-drawer-${CMAKE_MATCH_2}-meshes-${CMAKE_MATCH_3}-of-${CMAKE_MATCH_4}")
    endif()
endif()
if(NOT out MATCHES "\\[trees\\] ([0-9]+) trees, [0-9]+ active, ([0-9]+) posed skeletons, ([0-9]+) steps, ([0-9]+) poses")
    string(APPEND failures " no-trees-line")
else()
    message("${ROW}: ${CMAKE_MATCH_1} trees, ${CMAKE_MATCH_2} posed skeletons, ${CMAKE_MATCH_3} steps, ${CMAKE_MATCH_4} poses")
    if(CMAKE_MATCH_1 EQUAL 0 OR CMAKE_MATCH_2 EQUAL 0 OR CMAKE_MATCH_3 EQUAL 0)
        string(APPEND failures " trees-${CMAKE_MATCH_1}-skeletons-${CMAKE_MATCH_2}-steps-${CMAKE_MATCH_3}")
    endif()
endif()
if(failures)
    message(FATAL_ERROR "${ROW}:${failures}")
endif()
message("${ROW}: PASS")
