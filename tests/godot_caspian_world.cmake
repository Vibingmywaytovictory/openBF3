cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)

godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 200 ARGS ${godot_log_args} --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn --
    --level=MP_007 --mode=ConquestLarge0 --bots=0 --preround=0 --quit-after=5 ${godot_cache_args})

set(failures "")
if(NOT out MATCHES "\\[level\\] view distance ([0-9]+) m")
    string(APPEND failures " no-view-distance")
elseif(CMAKE_MATCH_1 LESS 8100)
    string(APPEND failures " view-distance-${CMAKE_MATCH_1}-short-of-the-backdrop")
endif()
if(NOT out MATCHES "\\[level\\] terrain decals: 281 of 281 records drawn, 5 of 5 shaders[\r\n]")
    string(APPEND failures " terrain-decals")
endif()
if(NOT out MATCHES "\\[level\\] terrain water: 42 of 42 records drawn, 1 of 1 shaders, 648 triangles[\r\n]")
    string(APPEND failures " terrain-water")
endif()
if(NOT out MATCHES "\\[game\\] placed effects: 338 placed, 239 start at load, ([0-9]+) of them started")
    string(APPEND failures " no-placed-effects-line")
elseif(CMAKE_MATCH_1 EQUAL 0)
    string(APPEND failures " no-placed-effect-started")
endif()
if(failures)
    message(FATAL_ERROR "${ROW}:${failures}")
endif()
message("${ROW}: PASS")
