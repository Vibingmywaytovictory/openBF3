cmake_minimum_required(VERSION 3.29)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
foreach(launcher play server)
    file(READ "${PROJECT_DIR}/../tools/${launcher}.cmd" launcher_text)
    if(launcher_text MATCHES "--rendering-driver|--rendering-method|--display-driver|--gpu-index")
        message(FATAL_ERROR "${ROW}: tools/${launcher}.cmd picks the renderer itself instead of the project's Vulkan driver")
    endif()
endforeach()
file(READ "${PROJECT_DIR}/../tools/play.cmd" play_text)
if(NOT play_text MATCHES [=[--path "%ROOT%\\bf3-opensource"]=])
    message(FATAL_ERROR "${ROW}: tools/play.cmd does not start the bf3-opensource project, whose settings this row reads")
endif()
godot_run(TIMEOUT 120 ARGS --headless ${godot_log_args} --path "${PROJECT_DIR}" --quit)
if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "${ROW}: the main scene did not quit cleanly (exit ${rc})")
endif()
if(NOT out MATCHES "\\[openbf3\\] rendering driver [^ \n]+ \\(project: ([^,\n]*), fallback to d3d12: (on|off), fallback to opengl3: (on|off)\\)")
    message(FATAL_ERROR "${ROW}: no rendering driver line")
endif()
set(project_driver "${CMAKE_MATCH_1}")
set(d3d12_fallback "${CMAKE_MATCH_2}")
set(opengl3_fallback "${CMAKE_MATCH_3}")
message("${ROW}: project driver ${project_driver}, fallback to d3d12 ${d3d12_fallback}, fallback to opengl3 ${opengl3_fallback}")
if(NOT project_driver STREQUAL "vulkan")
    message(FATAL_ERROR "${ROW}: a Windows launch of the project asks Godot for '${project_driver}', not vulkan")
endif()
if(NOT d3d12_fallback STREQUAL "off" OR NOT opengl3_fallback STREQUAL "off")
    message(FATAL_ERROR "${ROW}: Godot falls back to another driver when Vulkan fails to start, so the game can run on it unseen")
endif()
message("RENDERING DRIVER: PASS")
