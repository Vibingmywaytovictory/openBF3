cmake_minimum_required(VERSION 3.29)
if(NOT EXISTS "${EXE}")
	message(FATAL_ERROR "run_case_row: EXE '${EXE}' does not exist")
endif()

function(list_cases r_names)
	execute_process(COMMAND "${EXE}" "--test-suite=${SUITE}" ${ARGN} --list-test-cases
		RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
	if(NOT rc EQUAL 0)
		message(FATAL_ERROR "run_case_row: listing failed (${rc}): ${err}")
	endif()
	string(REPLACE ";" "," out "${out}")
	string(REPLACE "\r" "" out "${out}")
	string(REPLACE "\n" ";" lines "${out}")
	set(names "")
	set(state 0)
	foreach(line IN LISTS lines)
		if(state EQUAL 0)
			if(line MATCHES "listing all test case names")
				set(state 1)
			endif()
		elseif(state EQUAL 1)
			if(line MATCHES "^=+$")
				set(state 2)
			endif()
		elseif(line MATCHES "^=+$")
			break()
		elseif(NOT line STREQUAL "")
			list(APPEND names "${line}")
		endif()
	endforeach()
	set(${r_names} "${names}" PARENT_SCOPE)
endfunction()

function(filter_args r_args p_cases p_exclude)
	set(args "")
	if(NOT p_cases STREQUAL "")
		list(APPEND args "--test-case=${p_cases}")
	endif()
	if(NOT p_exclude STREQUAL "")
		list(APPEND args "--test-case-exclude=${p_exclude}")
	endif()
	set(${r_args} "${args}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "cover")
	include("${ROWS_FILE}")
	list_cases(all)
	list(LENGTH all nall)
	if(nall EQUAL 0)
		message(FATAL_ERROR "run_case_row: suite ${SUITE} lists no cases")
	endif()
	foreach(name IN LISTS all)
		string(MD5 key "${name}")
		set(hits_${key} 0)
		set(rows_${key} "")
	endforeach()
	set(install_name "")
	if(DEFINED INSTALL_CASE AND NOT INSTALL_CASE STREQUAL "")
		list_cases(install_names "--test-case=${INSTALL_CASE}")
		list(LENGTH install_names ninstall)
		if(NOT ninstall EQUAL 1)
			message(FATAL_ERROR "run_case_row: INSTALL_CASE '${INSTALL_CASE}' selects ${ninstall} cases of ${SUITE}, not 1")
		endif()
		set(install_name "${install_names}")
	endif()
	set(bad 0)
	foreach(row IN LISTS ROWS)
		filter_args(args "${ROW_${row}_CASES}" "${ROW_${row}_EXCLUDE}")
		list_cases(selected ${args})
		list(LENGTH selected nsel)
		message("${row}: ${nsel} cases")
		if(NOT install_name STREQUAL "" AND NOT install_name IN_LIST selected)
			message("MISSING: ${row} does not run the install-unchanged case '${install_name}'")
			math(EXPR bad "${bad} + 1")
		endif()
		foreach(name IN LISTS selected)
			string(MD5 key "${name}")
			if(NOT DEFINED hits_${key})
				message("UNKNOWN: ${row} lists '${name}', which the full suite does not")
				math(EXPR bad "${bad} + 1")
				continue()
			endif()
			math(EXPR hits_${key} "${hits_${key}} + 1")
			list(APPEND rows_${key} "${row}")
		endforeach()
	endforeach()
	foreach(name IN LISTS all)
		if(name STREQUAL install_name)
			continue()
		endif()
		string(MD5 key "${name}")
		if(hits_${key} EQUAL 0)
			message("UNCOVERED: '${name}' is in no split row")
			math(EXPR bad "${bad} + 1")
		elseif(hits_${key} GREATER 1)
			string(REPLACE ";" " " r "${rows_${key}}")
			message("TWICE: '${name}' is in ${hits_${key}} rows (${r})")
			math(EXPR bad "${bad} + 1")
		endif()
	endforeach()
	list(LENGTH ROWS nrows)
	if(bad GREATER 0)
		message(FATAL_ERROR "split_cover ${SUITE}: ${bad} problem(s) over ${nall} cases and ${nrows} rows")
	endif()
	message("split_cover ${SUITE}: ${nall} cases, each in exactly one of ${nrows} rows")
	return()
endif()

if(NOT DEFINED COUNT OR NOT COUNT MATCHES "^[0-9]+$")
	message(FATAL_ERROR "run_case_row: -DCOUNT=<n> is required")
endif()
filter_args(args "${CASES}" "${EXCLUDE}")
execute_process(COMMAND "${EXE}" "--test-suite=${SUITE}" ${args}
	RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("${out}")
if(NOT err STREQUAL "")
	message("${err}")
endif()
if(rc STREQUAL "77")
	cmake_language(EXIT 77)
endif()
if(NOT rc STREQUAL "0")
	message(FATAL_ERROR "case row ${SUITE}: exit ${rc}")
endif()
if(NOT out MATCHES "test cases: +${COUNT} [|] +${COUNT} passed [|] +0 failed")
	string(REGEX MATCH "test cases:[^\n]*" summary "${out}")
	message(FATAL_ERROR "case row ${SUITE}: expected ${COUNT} cases, all passed; doctest says '${summary}'")
endif()
