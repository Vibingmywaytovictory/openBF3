cmake_minimum_required(VERSION 3.29)

if(NOT BF3DUMP OR NOT EXISTS "${BF3DUMP}")
    message(FATAL_ERROR "m1_prepare: BF3DUMP=<bf3dump.exe> is required")
endif()
set(E6_LIMIT_MIB 512)

string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _tag)
file(TO_CMAKE_PATH "$ENV{TEMP}" _temp)
set(ROOT "${_temp}/o3p-${_tag}")
file(REMOVE_RECURSE "${ROOT}")
file(TO_NATIVE_PATH "${ROOT}" ROOT_NATIVE)

set(_failed 0)
macro(report _ok _what)
    if(${_ok})
        message(STATUS "  ok    ${_what}")
    else()
        message(STATUS "  FAIL  ${_what}")
        set(_failed 1)
    endif()
endmacro()

function(run_prepare _label _out_var)
    execute_process(COMMAND "${BF3DUMP}" prepare MP_Subway TeamDeathMatch0 --shapes "--cache=${ROOT_NATIVE}"
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 300)
    message(STATUS "---- ${_label} (exit ${_rc}) ----\n${_out}")
    if(_rc EQUAL 77)
        message(STATUS "m1_prepare: no install (bf3dump exit 77): ${_err}")
        file(REMOVE_RECURSE "${ROOT}")
        cmake_language(EXIT 77)
    endif()
    if(NOT _rc EQUAL 0)
        message(STATUS "${_err}")
    endif()
    set(${_out_var} "${_out}" PARENT_SCOPE)
    set(${_out_var}_RC "${_rc}" PARENT_SCOPE)
endfunction()

run_prepare("cold (fresh root)" COLD)
run_prepare("warm (same root)" WARM)
file(REMOVE_RECURSE "${ROOT}")

message(STATUS "tools.m1_prepare checks:")
if(COLD_RC EQUAL 0)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "cold: exit 0")
string(REGEX MATCH "peak working set ([0-9]+)\\.([0-9]) MiB" _m "${COLD}")
set(_peak "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}")
set(_peak_int "${CMAKE_MATCH_1}")
if(NOT _m)
    set(_peak_int 999999)
    set(_peak "unknown")
endif()
if(E6_REPORT_ONLY)
    message(STATUS "  info  E6 (report only under ASan): cold peak working set ${_peak} MiB, gate ${E6_LIMIT_MIB} MiB")
else()
    if(_peak_int LESS ${E6_LIMIT_MIB})
        set(_ok TRUE)
    else()
        set(_ok FALSE)
    endif()
    report(_ok "E6: cold peak working set ${_peak} MiB <= ${E6_LIMIT_MIB} MiB")
endif()
string(REGEX MATCH "peak working set ([0-9]+)[.0-9]* MiB, peak private bytes ([0-9]+)[.0-9]* MiB" _m "${COLD}")
if(_m AND CMAKE_MATCH_2 GREATER 0)
    set(_ws_int "${CMAKE_MATCH_1}")
    set(_commit_int "${CMAKE_MATCH_2}")
    math(EXPR _ratio "${_ws_int} * 1000 / ${_commit_int}")
    message(STATUS "  info  cold peak commit (PeakPagefileUsage) ${_commit_int} MiB; peak ws / commit ${_ratio} / 1000 (serial 943)")
    if(_ratio LESS 754)
        message(STATUS "  WARN  cold peak ws / commit ${_ratio} / 1000 is below 0.8 x serial: the working set was trimmed")
    endif()
endif()
string(REGEX MATCH "meshes +([0-9]+) items: 0 hits, ([0-9]+) misses \\(([0-9]+) converted, 0 reused, 0 uncached\\), 0 failed" _m "${COLD}")
if(_m AND CMAKE_MATCH_1 EQUAL CMAKE_MATCH_3)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "cold: every mesh item converted (${CMAKE_MATCH_3} of ${CMAKE_MATCH_1})")
string(REGEX MATCH "weapons +([0-9]+) items: 0 hits, ([0-9]+) misses \\(([0-9]+) converted, 0 reused, 0 uncached\\), 0 failed" _m "${COLD}")
if(_m AND CMAKE_MATCH_1 EQUAL CMAKE_MATCH_3)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "cold: every weapon converted (${CMAKE_MATCH_3} of ${CMAKE_MATCH_1})")
string(REGEX MATCH "shapes +world miss; 0 of ([0-9]+) tiles hit, ([0-9]+) cooked" _m "${COLD}")
if(_m AND CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2 AND CMAKE_MATCH_1 GREATER 0)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "cold: world miss, every tile cooked (${CMAKE_MATCH_2} of ${CMAKE_MATCH_1})")
string(FIND "${COLD}" "install.unchanged yes" _at)
if(_at GREATER -1)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "cold: install.unchanged")
if(WARM_RC EQUAL 0)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "warm: exit 0")
string(REGEX MATCH "meshes +([0-9]+) items: ([0-9]+) hits, 0 misses" _m "${WARM}")
if(_m AND CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "warm: every mesh item a hit (${CMAKE_MATCH_2} of ${CMAKE_MATCH_1})")
string(REGEX MATCH "weapons +([0-9]+) items: ([0-9]+) hits, 0 misses" _m "${WARM}")
if(_m AND CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "warm: every weapon a hit (${CMAKE_MATCH_2} of ${CMAKE_MATCH_1})")
string(REGEX MATCH "shapes +world hit \\(no soup\\); ([0-9]+) of ([0-9]+) tiles hit, 0 cooked" _m "${WARM}")
if(_m AND CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "warm: world hit, no soup, every tile restored (${CMAKE_MATCH_1} of ${CMAKE_MATCH_2})")
string(REGEX MATCH "cache +([0-9]+) -> ([0-9]+) entries, [0-9.]+ -> [0-9.]+ MiB; 0 puts, ([0-9]+) hits, 0 misses" _m "${WARM}")
if(_m AND CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "warm: 0 puts, 0 misses (${CMAKE_MATCH_3} hits, ${CMAKE_MATCH_2} entries)")
string(REGEX MATCH "peak working set ([0-9.]+) MiB" _m "${WARM}")
message(STATUS "  info  warm peak working set ${CMAKE_MATCH_1} MiB")
string(FIND "${WARM}" "install.unchanged yes" _at)
if(_at GREATER -1)
    set(_ok TRUE)
else()
    set(_ok FALSE)
endif()
report(_ok "warm: install.unchanged")

if(_failed)
    message(FATAL_ERROR "tools.m1_prepare: FAIL")
endif()
message(STATUS "tools.m1_prepare: PASS (E6 peak ${_peak} MiB <= ${E6_LIMIT_MIB} MiB)")
