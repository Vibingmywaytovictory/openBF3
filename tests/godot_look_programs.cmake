cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(cache "${BUILD_DIR}/godot-cache/${ROW}")
set(shots "${BUILD_DIR}/shots/${ROW}")
file(REMOVE_RECURSE "${cache}" "${shots}")
file(MAKE_DIRECTORY "${cache}" "${shots}")
set(look_args "")
if(DEFINED LOOK_OFF)
    set(look_args "--look-off=${LOOK_OFF}")
endif()
set(views "${shots}/river_e.png@-108,134,114,90,-20;${shots}/river_n.png@-120,134,102,0,-20;${shots}/river_w.png@-134,134,114,-90,-20;${shots}/river_s.png@-120,134,126,180,-20")
string(REPLACE ";" "\\;" views_arg "${views}")
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300 REMOVE_ON_SKIP "${cache}"
    ARGS --path "${PROJECT_DIR}" --resolution 1280x720 res://scenes/metro_tdm.tscn -- --level=MP_007 --mode=TeamDeathMatchC0
        --bots=0 --deploy-screen=0 --shot-settle=3 "--shots=${views_arg}" --quit-after=1 "--bf3-cache=${cache}" ${look_args})
file(REMOVE_RECURSE "${cache}")
if(out MATCHES "SHADER ERROR" OR err MATCHES "SHADER ERROR")
    message(FATAL_ERROR "${ROW}: a translated material program did not compile")
endif()
godot_require_pass("\\[level\\] install unchanged: yes")
if(NOT out MATCHES "\\[level\\] graph programs: ([0-9]+) shaders, ([0-9]+) materials, ([0-9]+) instances")
    message(FATAL_ERROR "${ROW}: no graph programs line")
endif()
set(program_shaders ${CMAKE_MATCH_1})
set(program_materials ${CMAKE_MATCH_2})
set(program_instances ${CMAKE_MATCH_3})
message("${ROW}: ${program_shaders} program shaders, ${program_materials} materials and ${program_instances} instances draw through them")
if(program_materials LESS MIN_MATERIALS OR program_instances LESS MIN_INSTANCES)
    message(FATAL_ERROR "${ROW}: ${program_materials} materials and ${program_instances} instances draw through their programs, "
        "not the ${MIN_MATERIALS} and ${MIN_INSTANCES} of MP_007's rocks and masks")
endif()
file(GLOB pngs "${shots}/river_*.png")
list(LENGTH pngs count)
if(NOT count EQUAL 4)
    message(FATAL_ERROR "${ROW}: ${count} of 4 shots written")
endif()
execute_process(COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/look_shot_colours.py" "${MAGENTA_LIMIT}" ${pngs}
    RESULT_VARIABLE colours_rc OUTPUT_VARIABLE colours_out ERROR_VARIABLE colours_err)
message("${colours_out}${colours_err}")
if(NOT colours_rc STREQUAL "0")
    message(FATAL_ERROR "${ROW}: magenta in the MP_007 river shots")
endif()
message("LOOK PROGRAMS: PASS")
