function(openbf3_scratch_dir out_var name)
    set(temp "$ENV{TMP}")
    if(temp STREQUAL "")
        set(temp "$ENV{TEMP}")
    endif()
    if(temp STREQUAL "" OR NOT name MATCHES "^[A-Za-z0-9_-]+$")
        message(FATAL_ERROR "openbf3_scratch_dir: no TMP/TEMP, or '${name}' is not a scratch name ([A-Za-z0-9_-])")
    endif()
    file(TO_CMAKE_PATH "${temp}" temp)
    set(pass_tag "$ENV{OPENBF3_SCRATCH_TAG}")
    string(LENGTH "${pass_tag}" pass_tag_length)
    if(pass_tag_length EQUAL 8 AND pass_tag MATCHES "^[0-9a-f]+$")
        set(name "${pass_tag}.${name}")
    endif()
    foreach(attempt RANGE 16)
        string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef tag)
        set(dir "${temp}/openbf3-tests/${name}-cmake-${tag}")
        if(NOT EXISTS "${dir}" AND NOT EXISTS "${dir}.lock")
            file(MAKE_DIRECTORY "${temp}/openbf3-tests")
            file(LOCK "${dir}.lock" GUARD PROCESS RESULT_VARIABLE locked TIMEOUT 0)
            if(locked STREQUAL "0")
                file(MAKE_DIRECTORY "${dir}")
                set(${out_var} "${dir}" PARENT_SCOPE)
                set_property(GLOBAL APPEND PROPERTY OPENBF3_SCRATCH_DIRS "${dir}")
                return()
            endif()
        endif()
    endforeach()
    message(FATAL_ERROR "openbf3_scratch_dir: could not lock a scratch folder under ${temp}/openbf3-tests")
endfunction()

function(openbf3_scratch_remove dir)
    get_property(dirs GLOBAL PROPERTY OPENBF3_SCRATCH_DIRS)
    if(NOT dir IN_LIST dirs)
        return()
    endif()
    list(REMOVE_ITEM dirs "${dir}")
    set_property(GLOBAL PROPERTY OPENBF3_SCRATCH_DIRS "${dirs}")
    file(REMOVE_RECURSE "${dir}")
    file(LOCK "${dir}.lock" RELEASE RESULT_VARIABLE released)
    file(REMOVE "${dir}.lock")
endfunction()

function(openbf3_scratch_remove_all)
    get_property(dirs GLOBAL PROPERTY OPENBF3_SCRATCH_DIRS)
    foreach(dir IN LISTS dirs)
        openbf3_scratch_remove("${dir}")
    endforeach()
endfunction()
