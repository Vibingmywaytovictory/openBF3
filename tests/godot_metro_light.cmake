cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(cache "${BUILD_DIR}/godot-cache/${ROW}")
file(MAKE_DIRECTORY "${cache}")
set(shots "${BUILD_DIR}/shots/${ROW}")
file(REMOVE_RECURSE "${shots}")
file(MAKE_DIRECTORY "${shots}")

set(names hall_strip deep_tunnel ticket_hall park)
set(view_hall_strip "-167.76,66.2,-475.19,-150.8,0")
set(view_deep_tunnel "-190.0,61.0,-356.3,180,0")
set(view_ticket_hall "-154.3,66.1,-493.9,0,0")
set(view_park "-40,110,-230,30,-20")

set(views "")
foreach(name IN LISTS names)
    list(APPEND views "${shots}/${name}.png@${view_${name}}")
endforeach()
string(REPLACE ";" "\\;" views "${views}")
godot_run(QUIET SKIP_WITHOUT_INSTALL TIMEOUT 300
    ARGS --resolution 1280x720 --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn -- --level=MP_Subway --mode=ConquestLarge0
        --bots=0 --deploy-screen=0 --no-hud "--bf3-cache=${cache}" --shot-settle=3 "--shots=${views}")
string(REPLACE ";" "," text "${out}")
string(REGEX MATCHALL "\\[m1\\] shot look L1:[^\n]*" looks "${text}")
list(LENGTH looks n)
list(LENGTH names want)
if(NOT rc STREQUAL "0" OR NOT n EQUAL want)
    message("${out}")
    message("${err}")
    message(FATAL_ERROR "godot.metro_light: exited ${rc} with ${n} of ${want} look lines")
endif()
set(failed FALSE)
set(at 0)
foreach(name IN LISTS names)
    list(GET looks ${at} line)
    math(EXPR at "${at} + 1")
    message("${name}: ${line}")
    if(NOT line MATCHES ". shadow casters ([0-9]+) of ([0-9]+) instances double-sided")
        message("godot.metro_light: ${name}: no shadow caster count")
        set(failed TRUE)
    elseif(NOT CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2 OR CMAKE_MATCH_1 EQUAL 0)
        message("godot.metro_light: ${name}: ${CMAKE_MATCH_1} of ${CMAKE_MATCH_2} instances cast the sun's shadow from both sides")
        set(failed TRUE)
    endif()
endforeach()
string(REGEX MATCH "\\[level\\] install unchanged: yes" unchanged "${text}")
if(NOT unchanged)
    message("godot.metro_light: the install changed or the run did not say")
    set(failed TRUE)
endif()
if(failed)
    message(FATAL_ERROR "godot.metro_light: FAIL")
endif()
message("godot.metro_light: PASS (shots in ${shots})")
