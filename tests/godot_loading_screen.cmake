cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(cache_args "")
set(shot_args "")
if(DEFINED BUILD_DIR AND NOT BUILD_DIR STREQUAL "")
    set(cache "${BUILD_DIR}/godot-cache/godot.loading_screen")
    file(REMOVE_RECURSE "${cache}")
    file(MAKE_DIRECTORY "${cache}")
    set(cache_args "--bf3-cache=${cache}")
    set(shots "${BUILD_DIR}/shots/loading_screen")
    file(REMOVE_RECURSE "${shots}")
    file(MAKE_DIRECTORY "${shots}")
    set(shot_args "--loading-shots=${shots}")
endif()
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 220
    ARGS --path "${PROJECT_DIR}" --resolution 1280x720 res://scenes/metro_tdm.tscn -- --bots=0 --deploy-screen=1 --preround=0 --min-players=1
        --loading-screen-check ${cache_args} ${shot_args})
godot_require_pass("LOADING SCREEN: PASS")
godot_require_pass("cache cold. peak working set")
godot_require_pass("\\[level\\] install unchanged: yes")
