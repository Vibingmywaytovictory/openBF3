cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
openbf3_scratch_dir(scratch godot-ground-cover)
set(root "${scratch}/cache")
if("$ENV{OPENBF3_GROUND_COVER_SHOTS}" STREQUAL "")
    set(shots "${scratch}/shots")
    set(keep_shots FALSE)
else()
    file(TO_CMAKE_PATH "$ENV{OPENBF3_GROUND_COVER_SHOTS}" shots)
    set(keep_shots TRUE)
endif()
file(MAKE_DIRECTORY "${shots}")
if(NOT DEFINED LEVEL)
    set(LEVEL MP_007)
endif()
if(NOT DEFINED MODE)
    set(MODE ConquestLarge0)
endif()
if(NOT DEFINED TYPES)
    set(TYPES 23)
endif()
if(NOT DEFINED VIEWS)
    set(VIEWS "field@-236.9,141.8,-87.7,0,-8" "forest@-28.3,149.7,98.9,0,-8" "hill@-383.1,158.4,245.3,0,-8")
endif()
set(look_args "")
if(DEFINED LOOK_OFF)
    set(look_args "--look-off=${LOOK_OFF}")
endif()
set(list "")
foreach(view IN LISTS VIEWS)
    string(REPLACE "@" ".png@" view "${view}")
    list(APPEND list "${shots}/${LEVEL}_${view}")
endforeach()
list(JOIN list "\;" views)
godot_run(QUIET SKIP_WITHOUT_INSTALL TIMEOUT 600 REMOVE_ON_SKIP "${root}"
    ARGS --path "${PROJECT_DIR}" res://scenes/m1_metro.tscn -- "--level=${LEVEL}" "--mode=${MODE}" "--bf3-cache=${root}" --no-hud --shot-settle=6 --shot-measure=120
        "--shots=${views}" ${look_args} --quit-after=1)
set(failed FALSE)
string(REGEX MATCHALL "\\[m1\\] shot [^\n]*free camera[^\n]*" taken "${out}")
list(LENGTH taken n)
list(LENGTH list want)
if(NOT rc STREQUAL "0" OR NOT n EQUAL want)
    message("${out}")
    message("${err}")
    message("godot.ground_cover: exit ${rc}, ${n} of ${want} views taken")
    set(failed TRUE)
endif()
string(REGEX MATCHALL "\\[level\\] done[^\n]*" loads "${out}")
string(REGEX MATCHALL "\\[look\\] frame time [^\n]*" frames "${out}")
string(REGEX MATCHALL "\\[scatter\\] [^\n]*" reports "${out}")
foreach(line IN LISTS loads frames reports)
    message("${line}")
endforeach()
set(declared FALSE)
set(drawn_reports 0)
foreach(line IN LISTS reports)
    if(line MATCHES ": ([0-9]+) scattering types in the data, ([0-9]+) placed, ([0-9]+) mask programs")
        set(declared TRUE)
        if(NOT CMAKE_MATCH_1 EQUAL TYPES OR NOT CMAKE_MATCH_2 EQUAL TYPES OR CMAKE_MATCH_3 EQUAL 0)
            message("godot.ground_cover: ${CMAKE_MATCH_1} types read and ${CMAKE_MATCH_2} placed with ${CMAKE_MATCH_3} mask programs, the data has ${TYPES}")
            set(failed TRUE)
        endif()
    elseif(line MATCHES "([0-9]+) instances in ([0-9]+) multimeshes, ([0-9]+) of ([0-9]+) types drawn.* ([0-9]+) without a program.*per type(.*)$")
        set(instances "${CMAKE_MATCH_1}")
        set(unmatched "${CMAKE_MATCH_5}")
        set(per_type "${CMAKE_MATCH_6}")
        if(instances GREATER 0)
            math(EXPR drawn_reports "${drawn_reports} + 1")
        endif()
        if(NOT unmatched EQUAL 0)
            message("godot.ground_cover: ${unmatched} candidates found no mask program: ${line}")
            set(failed TRUE)
        endif()
        string(REGEX MATCHALL "[0-9]+:[0-9]+/[0-9]+" entries "${per_type}")
        foreach(entry IN LISTS entries)
            string(REGEX MATCH "([0-9]+):([0-9]+)/([0-9]+)" m "${entry}")
            if(CMAKE_MATCH_3 GREATER_EQUAL 8 AND CMAKE_MATCH_2 EQUAL 0)
                message("godot.ground_cover: type ${CMAKE_MATCH_1} draws no instance where its masks sum to ${CMAKE_MATCH_3}: ${line}")
                set(failed TRUE)
            endif()
        endforeach()
    endif()
endforeach()
if(NOT declared)
    message("godot.ground_cover: the level reported no scattering types: nothing is scattered on the terrain")
    set(failed TRUE)
endif()
if(drawn_reports LESS want)
    message("godot.ground_cover: ${drawn_reports} reports with instances drawn, ${want} views")
    set(failed TRUE)
endif()
set(tilted_reports 0)
foreach(line IN LISTS reports)
    if(line MATCHES " ([0-9]+) tilted to the terrain under them" AND CMAKE_MATCH_1 GREATER 0)
        math(EXPR tilted_reports "${tilted_reports} + 1")
    endif()
endforeach()
if(tilted_reports EQUAL 0)
    message("godot.ground_cover: no report draws an instance tilted to the slope of the terrain under it")
    set(failed TRUE)
endif()
string(REGEX MATCHALL "\\[detail\\] [^\n]* at the camera[^\n]*" details "${out}")
list(LENGTH details detail_reports)
foreach(line IN LISTS details)
    message("${line}")
    if(NOT line MATCHES "masks ([0-9.]+) m \\(data ([0-9.]+) m\\), colour ([0-9.]+) m \\(data ([0-9.]+) m\\) at the camera")
        message("godot.ground_cover: unreadable ground detail report")
        set(failed TRUE)
    elseif(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2 OR NOT CMAKE_MATCH_3 STREQUAL CMAKE_MATCH_4)
        message("godot.ground_cover: the ground under the camera is drawn coarser than the data")
        set(failed TRUE)
    endif()
endforeach()
if(detail_reports EQUAL 0)
    message("godot.ground_cover: no report of the ground's texel at the camera")
    set(failed TRUE)
endif()
set(typed 0)
foreach(line IN LISTS reports)
    if(line MATCHES " type ([0-9]+) ([^ ]+): ([0-9]+) drawn, mask sum ([0-9]+)")
        math(EXPR typed "${typed} + 1")
        set(drawn "${CMAKE_MATCH_3}")
        set(expected "${CMAKE_MATCH_4}")
        math(EXPR spread "(${drawn} - ${expected}) * (${drawn} - ${expected})")
        math(EXPR bound "16 * ${expected} + 16")
        if(spread GREATER bound)
            message("godot.ground_cover: type ${CMAKE_MATCH_1} ${CMAKE_MATCH_2} draws ${drawn} where its density and masks give ${expected}: ${line}")
            set(failed TRUE)
        endif()
    endif()
endforeach()
if(typed EQUAL 0)
    message("godot.ground_cover: no report of the instances each scattering type draws")
    set(failed TRUE)
endif()
openbf3_scratch_remove_all()
if(keep_shots)
    message("shots: ${shots}")
endif()
if(failed)
    message(FATAL_ERROR "godot.ground_cover: FAIL")
endif()
message("godot.ground_cover: PASS")
