add_library(test_proc_driver STATIC ${CMAKE_CURRENT_LIST_DIR}/net_procs_driver.cpp ${CMAKE_CURRENT_LIST_DIR}/net_procs_driver.h)
target_link_libraries(test_proc_driver PUBLIC bf3_core PRIVATE doctest::doctest)
target_compile_definitions(test_proc_driver PRIVATE DOCTEST_CONFIG_NO_EXCEPTIONS_BUT_WITH_ALL_ASSERTS)
target_include_directories(test_proc_driver PUBLIC ${CMAKE_CURRENT_LIST_DIR} PRIVATE ${CMAKE_SOURCE_DIR}/src/bf3_core/src)
openbf3_module(test_proc_driver)

function(openbf3_proc_row name exe)
    cmake_parse_arguments(PARSE_ARGV 2 P "" "LABEL;TIMEOUT" "ARGS")
    get_target_property(links ${exe} LINK_LIBRARIES)
    if(NOT "test_proc_driver" IN_LIST links)
        message(FATAL_ERROR "${name}: ${exe} must link test_proc_driver; a multi-process row starts its children only through ProcDriver")
    endif()
    get_target_property(sources ${exe} SOURCES)
    get_target_property(source_dir ${exe} SOURCE_DIR)
    foreach(source IN LISTS sources)
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${source_dir}" OUTPUT_VARIABLE path)
        if(path MATCHES "[.](cpp|h)$")
            file(READ "${path}" body)
            if(body MATCHES "CreateProcess|ShellExecute|WinExec|_w?spawn[lv]|_w?popen|std::system|[^_a-z]system[(]")
                message(FATAL_ERROR "${name}: ${path} starts a process itself; children start only through ProcDriver (tests/net_procs_driver.h), which gives each its own job and roots")
            endif()
        endif()
    endforeach()
    if(NOT "${P_LABEL}" STREQUAL "" AND NOT "${P_LABEL}" MATCHES "^(timing|realtime|window)$")
        message(FATAL_ERROR "openbf3_proc_row(${name}): LABEL is timing, realtime or window, not '${P_LABEL}'")
    endif()
    set(godot_project "")
    set(godot_server_project "")
    if(OPENBF3_BUILD_GODOT AND OPENBF3_BUILD_CHECKS AND CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
        set(godot_project "${OPENBF3_GODOT_PROJECT}")
        set(godot_server_project "${OPENBF3_GODOT_SERVER_PROJECT}")
    endif()
    set(godot_exe "")
    if(DEFINED OPENBF3_GODOT_EXE AND NOT OPENBF3_GODOT_EXE MATCHES "-NOTFOUND$")
        set(godot_exe "${OPENBF3_GODOT_EXE}")
    endif()
    set(window_row 0)
    if("${P_LABEL}" STREQUAL "window")
        set(window_row 1)
    endif()
    add_test(NAME ${name} COMMAND ${exe} ${P_ARGS})
    set_tests_properties(${name} PROPERTIES SKIP_RETURN_CODE 77 FIXTURES_REQUIRED godot_project
        RESOURCE_LOCK "openbf3_godot_project;openbf3_godot_server_project"
        ENVIRONMENT "OPENBF3_PROC_ROW=${name};OPENBF3_PROC_ROOT=${CMAKE_BINARY_DIR}/godot-cache;OPENBF3_PROC_GODOT_EXE=${godot_exe};OPENBF3_PROC_GODOT_PROJECT=${godot_project};OPENBF3_PROC_GODOT_SERVER_PROJECT=${godot_server_project};OPENBF3_PROC_BF3DUMP=$<TARGET_FILE:bf3dump>;OPENBF3_PROC_WINDOW_ROW=${window_row}")
    if(P_TIMEOUT)
        set_tests_properties(${name} PROPERTIES TIMEOUT ${P_TIMEOUT})
    endif()
    if(NOT "${P_LABEL}" STREQUAL "")
        set_property(TEST ${name} APPEND PROPERTY LABELS ${P_LABEL})
    endif()
    set_property(GLOBAL APPEND PROPERTY OPENBF3_PROC_ROWS ${name})
endfunction()

function(openbf3_check_rows)
    get_property(all_rows DIRECTORY PROPERTY TESTS)
    get_property(godot_rows GLOBAL PROPERTY OPENBF3_GODOT_ROWS)
    get_property(proc_rows GLOBAL PROPERTY OPENBF3_PROC_ROWS)
    foreach(row IN LISTS all_rows)
        if(row IN_LIST proc_rows OR row STREQUAL "godot.project_setup")
            continue()
        endif()
        if(row MATCHES "^godot[.]" AND NOT row IN_LIST godot_rows)
            message(FATAL_ERROR "${row}: register godot.* rows with openbf3_godot_row(HEADLESS|WINDOW) or openbf3_proc_row (docs/testing.md)")
        endif()
        if(row MATCHES "^net[.]procs[.]")
            message(FATAL_ERROR "${row}: register net.procs.* rows with openbf3_proc_row (docs/testing.md)")
        endif()
    endforeach()
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt" body)
    string(FIND "${body}" "\nopenbf3_check_rows()" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "openbf3_check_rows() is called from ${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt only, on a line of its own")
    endif()
    string(SUBSTRING "${body}" ${at} -1 tail)
    if(tail MATCHES "openbf3_(godot|proc)_row[(]|add_test[(]NAME[ \t\r\n]+\"?(godot|net[.]procs)[.]")
        message(FATAL_ERROR "a godot.* or net.procs.* row is registered after openbf3_check_rows(), which must follow every registration")
    endif()
endfunction()
