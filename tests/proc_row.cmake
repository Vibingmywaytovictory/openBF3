function(openbf3_check_rows)
    get_property(all_rows DIRECTORY PROPERTY TESTS)
    get_property(godot_rows GLOBAL PROPERTY OPENBF3_GODOT_ROWS)
    foreach(row IN LISTS all_rows)
        if(row MATCHES "^godot[.]" AND NOT row STREQUAL "godot.project_setup" AND NOT row IN_LIST godot_rows)
            message(FATAL_ERROR "${row}: register godot.* rows with openbf3_godot_row(HEADLESS|WINDOW) (docs/testing.md)")
        endif()
    endforeach()
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt" body)
    string(FIND "${body}" "\nopenbf3_check_rows()" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "openbf3_check_rows() is called from ${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt only, on a line of its own")
    endif()
    string(SUBSTRING "${body}" ${at} -1 tail)
    if(tail MATCHES "openbf3_godot_row[(]|add_test[(]NAME[ \t\r\n]+\"?godot[.]")
        message(FATAL_ERROR "a godot.* row is registered after openbf3_check_rows(), which must follow every registration")
    endif()
endfunction()
