cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
if(NOT DEFINED PHASE OR PHASE STREQUAL "")
    set(PHASE mix)
endif()
set(out "${BUILD_DIR}/shots/${ROW}")
set(cache "${BUILD_DIR}/godot-cache/godot.audio_ingame")
file(REMOVE_RECURSE "${out}")
file(MAKE_DIRECTORY "${out}" "${cache}")
if(PHASE STREQUAL "play")
    godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300
        ARGS --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn -- --bots=31 --preround=0 --quit-after=45
            --audio-max-voices=8 "--bf3-cache=${cache}")
    string(REGEX MATCHALL "\\[audio\\] sounds dropped: [0-9]+ outside the data's rules" periodic "${out}")
    list(LENGTH periodic periodic_lines)
    string(REGEX MATCH "\\[audio\\] audio health: [^\n]*sounds dropped: ([0-9]+) outside the data's rules" health "${out}")
    set(health_drops "${CMAKE_MATCH_1}")
    message("godot.audio_ingame.play: ${periodic_lines} periodic [audio] drop lines; shutdown health line drops outside the data's rules: '${health_drops}'")
    if(periodic_lines LESS 1 OR health_drops STREQUAL "" OR health_drops EQUAL 0)
        message(FATAL_ERROR "${ROW} failed: a plain play session at --audio-max-voices=8 prints no [audio] drop line or a shutdown health count of 0")
    endif()
    godot_require_pass("\\[level\\] install unchanged: yes")
    return()
endif()
set(extra "")
if(PHASE STREQUAL "pool")
    set(extra --audio-max-instances=24)
endif()
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 420
    ARGS --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn -- --bots=31 --preround=0 "--audio-ingame-check=${out}"
        "--audio-ingame-phase=${PHASE}" ${extra} "--bf3-cache=${cache}")
godot_require_pass("AUDIO INGAME: PASS")
godot_require_pass("\\[level\\] install unchanged: yes")
