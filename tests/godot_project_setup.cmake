cmake_minimum_required(VERSION 3.29)

function(setup_project p_project p_dll)
	set(cfg "${p_project}/.godot/extension_list.cfg")
	if(NOT EXISTS "${cfg}")
		file(GLOB extensions RELATIVE "${p_project}" "${p_project}/*.gdextension")
		list(TRANSFORM extensions PREPEND "res://")
		list(JOIN extensions "\n" extension_list)
		string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef tag)
		file(MAKE_DIRECTORY "${p_project}/.godot")
		file(WRITE "${cfg}.${tag}.tmp" "${extension_list}\n")
		file(RENAME "${cfg}.${tag}.tmp" "${cfg}" RESULT rename_rc)
		if(NOT rename_rc STREQUAL "0" AND NOT EXISTS "${cfg}")
			message(FATAL_ERROR "godot.project_setup: could not write ${cfg} (${rename_rc})")
		endif()
		file(REMOVE "${cfg}.${tag}.tmp")
		message("wrote ${cfg}")
	else()
		message("${cfg} present")
	endif()
	if(NOT p_dll STREQUAL "" AND NOT EXISTS "${p_dll}")
		message(FATAL_ERROR "godot.project_setup: the extension DLL ${p_dll} is missing (build the preset first)")
	endif()
	message("extension DLL ${p_dll} present")
endfunction()

function(check_engine_pin p_engine_api)
	include(${CMAKE_CURRENT_FUNCTION_LIST_DIR}/godot_exe.cmake)
	if(godot STREQUAL "" OR NOT EXISTS "${godot}")
		message("no Godot console executable: the engine pin is not checked")
		return()
	endif()
	get_filename_component(pinned "${p_engine_api}" NAME)
	execute_process(COMMAND "${godot}" --version OUTPUT_VARIABLE version RESULT_VARIABLE version_rc
		OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 30)
	string(REGEX REPLACE "^([0-9]+\\.[0-9]+(\\.[0-9]+)?\\.[a-z0-9]+)\\.[a-z_]+\\.([0-9a-f]+)$" "\\1.\\3" running "${version}")
	if(NOT version_rc STREQUAL "0" OR NOT running STREQUAL pinned)
		message(FATAL_ERROR "godot.project_setup: ${godot} is '${version}' (exit ${version_rc}), but the extension is built against ${pinned} (OPENBF3_ENGINE_API ${p_engine_api}): set OPENBF3_GODOT to that build or re-dump the API")
	endif()
	message("Godot ${version} is the pinned engine ${pinned}")
endfunction()

if(NOT DEFINED ENGINE_API OR ENGINE_API STREQUAL "")
	message(FATAL_ERROR "godot.project_setup needs ENGINE_API, the engine-api folder the extension is built against")
endif()
check_engine_pin("${ENGINE_API}")
setup_project("${PROJECT_DIR}" "${DLL}")
if(DEFINED SERVER_PROJECT_DIR AND NOT SERVER_PROJECT_DIR STREQUAL "")
	setup_project("${SERVER_PROJECT_DIR}" "${SERVER_DLL}")
endif()
