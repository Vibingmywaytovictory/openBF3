cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(shots "$ENV{OPENBF3_UI1_SHOTS}")
if(shots STREQUAL "")
    set(shots "${BUILD_DIR}/shots/ui1")
endif()
file(TO_CMAKE_PATH "${shots}" shots)
file(MAKE_DIRECTORY "${shots}")
foreach(png ui1_fonts.png ui1_coverage.png ui1_icons.png)
    file(REMOVE "${shots}/${png}")
endforeach()
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300 ARGS --path "${PROJECT_DIR}" res://scenes/ui_fonts.tscn -- --ui-check "--shot-dir=${shots}")
set(missing "")
foreach(png ui1_fonts.png ui1_coverage.png ui1_icons.png)
    if(NOT EXISTS "${shots}/${png}")
        string(APPEND missing " ${png}")
    endif()
endforeach()
godot_require_pass("UI1 CHECK: PASS" "; missing:${missing}")
if(NOT missing STREQUAL "")
    message(FATAL_ERROR "${ROW} failed (exit ${rc}; missing:${missing})")
endif()
message("shots: ${shots}")
