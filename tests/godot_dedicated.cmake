cmake_minimum_required(VERSION 3.29)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)

set(dedicated_args --headless ${godot_log_args} --path "${PROJECT_DIR}" --main-loop DedicatedMainLoop --
    --level=MP_Subway --mode=TeamDeathMatch0 --bots=31 --preround=0 ${godot_cache_args})

function(dedicated_number p_regex p_out)
    if(NOT out MATCHES "${p_regex}")
        message(FATAL_ERROR "${ROW}: no match for '${p_regex}' in the dedicated output")
    endif()
    set(${p_out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

if(TIMING)
    godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300 HEADER "warm-up" ARGS ${dedicated_args} --dedicated-seconds=1)
    if(NOT rc STREQUAL "0" OR NOT out MATCHES "\\[dedicated\\] summary: ")
        message(FATAL_ERROR "${ROW}: the warm-up run failed (exit ${rc})")
    endif()
    godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300 ARGS ${dedicated_args} --dedicated-seconds=40)
else()
    godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300 ARGS ${dedicated_args} --stop-after-kills=5 --dedicated-seconds=180)
endif()

if(out MATCHES "\\[dedicated\\] failed: ")
    message(FATAL_ERROR "${ROW}: the dedicated server failed")
endif()
godot_require_pass("\\[dedicated\\] summary: ")
if(NOT out MATCHES "\\[dedicated\\] t=[0-9.]+ s tick [0-9]+")
    message(FATAL_ERROR "${ROW}: no once-a-second server line")
endif()
dedicated_number("\\[dedicated\\] summary: MP_Subway TeamDeathMatch0 loaded in ([0-9.]+) s" load_s)
dedicated_number("summary: [^\n]* kills ([0-9]+)," kills)
dedicated_number("summary: [^\n]* stuck ([0-9]+)," stuck)
dedicated_number("summary: [^\n]* brain ([a-z0-9]+)," brain)
dedicated_number("summary: [^\n]* decisions ([0-9]+)," decisions)
dedicated_number("summary: [^\n]* private ([0-9.]+) MiB" private_mib)
dedicated_number("summary: [^\n]* godot nodes ([0-9]+)," nodes)
dedicated_number("summary: [^\n]* textures ([0-9]+) B," textures)
dedicated_number("summary: [^\n]*\\(([0-9.]+) Hz\\)" hz)
dedicated_number("summary: [^\n]* tick p99 ([0-9.]+) ms" p99)
set(failures "")
if(NOT out MATCHES "summary: [^\n]*, dev commands off, install unchanged,")
    string(APPEND failures " dev-commands-off/install")
endif()
if(NOT out MATCHES "\\[dedicated\\] extensions res://openbf3_server\\.gdextension, classes DedicatedMainLoop[\r\n]")
    string(APPEND failures " extensions-not-only-the-server")
endif()
if(nodes GREATER 0 OR textures GREATER 0)
    string(APPEND failures " godot-nodes-or-textures")
endif()
if(stuck GREATER 0)
    string(APPEND failures " stuck")
endif()
if(NOT brain STREQUAL "bf2" OR NOT decisions GREATER 0)
    string(APPEND failures " brain")
endif()
if(TIMING)
    if(NOT out MATCHES "MP_Subway TeamDeathMatch0 loaded in [0-9.]+ s: [^\n]*\\(cache hit\\)[^\n]*\\(nav cache hit\\)")
        string(APPEND failures " warm-cache")
    endif()
    if(load_s GREATER 2.0)
        string(APPEND failures " warm-load-over-2s")
    endif()
    if(hz LESS 59.4 OR hz GREATER 60.6)
        string(APPEND failures " 60Hz")
    endif()
    if(p99 GREATER_EQUAL 8.0)
        string(APPEND failures " tick-p99")
    endif()
else()
    if(kills LESS 5 OR NOT out MATCHES "stopped by --stop-after-kills")
        string(APPEND failures " kills")
    endif()
endif()
if(NOT TIMING)
    godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300 HEADER "default map list"
        ARGS --headless ${godot_log_args} --path "${PROJECT_DIR}" --main-loop DedicatedMainLoop -- --bots=0 --dedicated-seconds=1 ${godot_cache_args})
    if(NOT rc STREQUAL "0" OR NOT out MATCHES "\\[dedicated\\] summary: MP_Subway TeamDeathMatch0 loaded")
        string(APPEND failures " default-run")
    endif()
    if(NOT out MATCHES "\\[dedicated\\] map list MP_Subway TeamDeathMatch0 x1 \\(the first entry of [^\n]*/bf3-opensource/config/maplist\\.cfg in place")
        string(APPEND failures " default-first-entry-in-place")
    endif()
endif()
message("${ROW}: load ${load_s} s, kills ${kills}, stuck ${stuck}, brain ${brain}, decisions ${decisions}, private ${private_mib} MiB, ${hz} Hz, tick p99 ${p99} ms, godot nodes ${nodes}, textures ${textures} B")
if(NOT failures STREQUAL "")
    message(FATAL_ERROR "${ROW} failed:${failures}")
endif()
message("DEDICATED: PASS")
