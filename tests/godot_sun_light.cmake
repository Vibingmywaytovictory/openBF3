cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(cache "${BUILD_DIR}/godot-cache/${ROW}")
set(shots "${BUILD_DIR}/shots/${ROW}")
file(REMOVE_RECURSE "${cache}" "${shots}")
file(MAKE_DIRECTORY "${cache}" "${shots}")
string(REPLACE "|" ";" view_list "${VIEWS}")
set(views "")
foreach(view IN LISTS view_list)
    string(REPLACE "@" ".png@" shot "${view}")
    list(APPEND views "${shots}/${shot}")
endforeach()
list(LENGTH views view_count)
string(REPLACE ";" "\\;" views_arg "${views}")
set(patch_args "")
if(DEFINED PATCH_POINT)
    set(patch_args "--look-exposure=${PATCH_EXPOSURE}" "--shot-points=${PATCH_POINT}")
endif()
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300 REMOVE_ON_SKIP "${cache}"
    ARGS --path "${PROJECT_DIR}" --resolution 1280x720 res://scenes/metro_tdm.tscn -- --level=${LEVEL} --mode=${MODE}
        --bots=0 --deploy-screen=0 --preround=0 --min-players=1 --no-hud --shot-settle=4 "--shots=${views_arg}"
        ${patch_args} --quit-after=1 "--bf3-cache=${cache}")
file(REMOVE_RECURSE "${cache}")
if(out MATCHES "SHADER ERROR" OR err MATCHES "SHADER ERROR")
    message(FATAL_ERROR "${ROW}: a material shader did not compile")
endif()
godot_require_pass("\\[level\\] install unchanged: yes")
if(DEFINED PATCH_POINT)
    set(centres "")
    foreach(view toward away side_a side_b)
        if(NOT out MATCHES "\\[m1\\] shot points [^\n]*/patch_${view}\\.png: ([0-9.]+),([0-9.]+)")
            message(FATAL_ERROR "${ROW}: the terrain patch is not in the ${view} shot")
        endif()
        list(APPEND centres "${view}=${CMAKE_MATCH_1},${CMAKE_MATCH_2}")
    endforeach()
    execute_process(COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/sun_patch_shots.py" "${shots}" patch_ ${PATCH_HALF}
            ${centres}
        RESULT_VARIABLE patch_rc OUTPUT_VARIABLE patch_out ERROR_VARIABLE patch_err)
    message("${ROW}: ${patch_out}${patch_err}")
    if(NOT patch_rc STREQUAL "0")
        message(FATAL_ERROR "${ROW}: the grass-covered terrain patch is brighter toward the sun than its view-independent "
            "spread, while the terrain combinations and the moorland grass write their specular lanes as 0")
    endif()
endif()
if(NOT out MATCHES "\\[level\\] light pass: ([0-9]+) of ([0-9]+) level materials \\(([0-9]+) with their program's smoothness and specular, of ([0-9]+) whose program's lanes slice\\), ([0-9]+) of ([0-9]+) terrain materials")
    message(FATAL_ERROR "${ROW}: no light pass line")
endif()
set(lit ${CMAKE_MATCH_1})
set(level ${CMAKE_MATCH_2})
set(gloss ${CMAKE_MATCH_3})
set(sliced ${CMAKE_MATCH_4})
set(terrain_lit ${CMAKE_MATCH_5})
set(terrain ${CMAKE_MATCH_6})
message("${ROW}: ${lit} of ${level} level materials and ${terrain_lit} of ${terrain} terrain materials lit by the light pass, "
    "${gloss} with their program's smoothness and specular of ${sliced} whose program's lanes slice")
if(NOT lit EQUAL level OR NOT terrain_lit EQUAL terrain OR terrain LESS 1 OR NOT gloss EQUAL sliced OR NOT gloss EQUAL GLOSS)
    message(FATAL_ERROR "${ROW}: every level and terrain material lights through the light pass and the ${GLOSS} level "
        "materials whose program's lanes slice draw them")
endif()
string(REGEX MATCHALL "measured exposure [0-9.]+ at luminance [0-9.]+" measured "${out}")
foreach(m IN LISTS measured)
    message("${ROW}: ${m}")
endforeach()
file(GLOB pngs "${shots}/*.png")
list(LENGTH pngs count)
if(NOT count EQUAL view_count)
    message(FATAL_ERROR "${ROW}: ${count} of ${view_count} shots written")
endif()
message("SUN LIGHT: PASS")
