cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(shots "$ENV{OPENBF3_FX2_SHOT_DIR}")
if(shots STREQUAL "")
    get_filename_component(shots "${PROJECT_DIR}/../b/shots/fx2" ABSOLUTE)
endif()
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef tag)
set(root "${BUILD_DIR}/scratch/godot-fx2-${tag}")
file(MAKE_DIRECTORY "${BUILD_DIR}/scratch")
file(REMOVE_RECURSE "${root}")
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 1200 REMOVE_ON_SKIP "${root}"
    ARGS --path "${PROJECT_DIR}" res://scenes/fx_demo.tscn -- --fx-check --walkers=0 --no-hud "--bf3-cache=${root}"
        "--fx-shot-dir=${shots}" --quit-after=900)
file(REMOVE_RECURSE "${root}")
godot_require_pass("FX DEMO: PASS" "; shots in ${shots}")
message("${ROW}: PASS; shots in ${shots}")
