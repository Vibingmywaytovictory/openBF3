cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)

set(shots "${BUILD_DIR}/shots/${ROW}")
file(REMOVE_RECURSE "${shots}")
file(MAKE_DIRECTORY "${shots}")
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300 ARGS --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn --
    --level=MP_Subway --mode=TeamDeathMatch0 --bots=31 --preround=0 --quit-after=${QUIT_AFTER}
    "--audio-ingame-check=${shots}" --audio-ingame-phase=flyby --audio-ingame-seconds=${QUIT_AFTER} ${godot_cache_args})

set(failures "")
if(NOT out MATCHES "\\[game\\] effect lights: ([0-9]+) frames, at most ([0-9]+) light particles, ([0-9]+) lights asked for and ([0-9]+) shown, ([0-9]+) frames over the pool, ([0-9]+) dropped")
    string(APPEND failures " no-effect-lights-line")
else()
    set(particles ${CMAKE_MATCH_2})
    set(asked ${CMAKE_MATCH_3})
    set(shown ${CMAKE_MATCH_4})
    set(over ${CMAKE_MATCH_5})
    set(dropped ${CMAKE_MATCH_6})
    message("${ROW}: ${CMAKE_MATCH_1} frames, ${particles} light particles, ${asked} asked, ${shown} shown, ${over} frames over, ${dropped} dropped")
    if(particles EQUAL 0)
        string(APPEND failures " no-light-particles")
    endif()
    if(NOT dropped EQUAL 0 OR NOT over EQUAL 0)
        string(APPEND failures " lights-dropped-${dropped}-in-${over}-frames")
    endif()
endif()
if(NOT out MATCHES "impacts ([0-9]+) started, ([0-9]+) culled, ([0-9]+) with a light, at most ([0-9]+) impact lights in ([0-9]+) frames, ([0-9]+) lit effects cut short, ([0-9]+) impact lights ended by their shooter's next hit, ([0-9]+) frames with a shooter's lit impacts over MaxInstanceCount, ([0-9]+) frames where the shown impact lights differ from the lit impact emitters")
    string(APPEND failures " no-impact-light-counts")
else()
    message("${ROW}: impacts ${CMAKE_MATCH_1} started, ${CMAKE_MATCH_2} culled, ${CMAKE_MATCH_3} with a light, at most ${CMAKE_MATCH_4} impact lights in ${CMAKE_MATCH_5} frames, ${CMAKE_MATCH_6} cut short, ${CMAKE_MATCH_7} ended by the next hit, ${CMAKE_MATCH_8} frames over MaxInstanceCount, ${CMAKE_MATCH_9} frames shown differ from lit")
    if(CMAKE_MATCH_3 EQUAL 0 OR CMAKE_MATCH_4 EQUAL 0)
        string(APPEND failures " no-impact-lights-under-fire")
    endif()
    if(NOT CMAKE_MATCH_6 EQUAL 0)
        string(APPEND failures " lit-effects-cut-short-${CMAKE_MATCH_6}")
    endif()
    if(NOT CMAKE_MATCH_8 EQUAL 0)
        string(APPEND failures " lit-impacts-over-max-instance-count-in-${CMAKE_MATCH_8}-frames")
    endif()
    if(NOT CMAKE_MATCH_9 EQUAL 0)
        string(APPEND failures " impact-lights-not-shown-in-${CMAKE_MATCH_9}-frames")
    endif()
endif()
if(NOT out MATCHES "impact emitters, ([0-9]+) of ([0-9]+) particle lights off their curve, ([0-9]+) of ([0-9]+) effect lights not at their particles' mean")
    string(APPEND failures " no-light-curve-counts")
else()
    message("${ROW}: ${CMAKE_MATCH_1} of ${CMAKE_MATCH_2} particle lights off their curve, ${CMAKE_MATCH_3} of ${CMAKE_MATCH_4} effect lights off their mean")
    if(CMAKE_MATCH_2 EQUAL 0 OR NOT CMAKE_MATCH_1 EQUAL 0)
        string(APPEND failures " particle-lights-off-curve-${CMAKE_MATCH_1}-of-${CMAKE_MATCH_2}")
    endif()
    if(CMAKE_MATCH_4 EQUAL 0 OR NOT CMAKE_MATCH_3 EQUAL 0)
        string(APPEND failures " effect-lights-off-mean-${CMAKE_MATCH_3}-of-${CMAKE_MATCH_4}")
    endif()
endif()
if(failures)
    message(FATAL_ERROR "${ROW}:${failures}")
endif()
message("${ROW}: PASS")
