cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)

godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 300 ARGS --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn --
    --level=MP_Subway --mode=TeamDeathMatch0 --bots=31 --preround=0 --quit-after=${QUIT_AFTER} ${godot_cache_args})

set(failures "")
if(NOT out MATCHES "\\[game\\] effect lights: ([0-9]+) frames, at most ([0-9]+) light particles, ([0-9]+) lights asked for and ([0-9]+) shown, ([0-9]+) frames over the pool, ([0-9]+) dropped")
    string(APPEND failures " no-effect-lights-line")
else()
    set(particles ${CMAKE_MATCH_2})
    set(asked ${CMAKE_MATCH_3})
    set(shown ${CMAKE_MATCH_4})
    set(over ${CMAKE_MATCH_5})
    set(dropped ${CMAKE_MATCH_6})
    message("${ROW}: ${CMAKE_MATCH_1} frames, ${particles} light particles, ${asked} asked, ${shown} shown, ${over} frames over, ${dropped} dropped")
    if(particles EQUAL 0)
        string(APPEND failures " no-light-particles")
    endif()
    if(NOT dropped EQUAL 0 OR NOT over EQUAL 0)
        string(APPEND failures " lights-dropped-${dropped}-in-${over}-frames")
    endif()
endif()
if(failures)
    message(FATAL_ERROR "${ROW}:${failures}")
endif()
message("${ROW}: PASS")
