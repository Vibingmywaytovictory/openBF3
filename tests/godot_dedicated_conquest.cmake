cmake_minimum_required(VERSION 3.29)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)

if(NOT DEFINED LEVEL OR NOT DEFINED MODE OR NOT DEFINED TICKETS OR NOT DEFINED SECONDS)
    message(FATAL_ERROR "${ROW}: needs -DLEVEL, -DMODE, -DTICKETS and -DSECONDS")
endif()

godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 240 ARGS --headless ${godot_log_args} --path "${PROJECT_DIR}" --main-loop DedicatedMainLoop --
    --level=${LEVEL} --mode=${MODE} --bots=31 --preround=0 --game-mode-counter=50 --ticket-bleed=on
    --dedicated-seconds=${SECONDS} ${godot_cache_args})

if(out MATCHES "\\[dedicated\\] failed: ")
    message(FATAL_ERROR "${ROW}: the dedicated server failed")
endif()
godot_require_pass("\\[dedicated\\] summary: ")
set(failures "")
if(NOT out MATCHES "\\[dedicated\\] summary: ${LEVEL} ${MODE} loaded in ")
    string(APPEND failures " not-${LEVEL}-${MODE}")
endif()
if(NOT out MATCHES "\\[dedicated\\] rules Conquest: game mode counter 50 %, deserting killed, ticket bleed on, only squad leader spawn off")
    string(APPEND failures " settings-line")
endif()
if(NOT out MATCHES "\\[dedicated\\] conquest summary: tickets US ([0-9]+) of ([0-9]+)[a-z ]*, RU ([0-9]+) of ([0-9]+)[a-z ]*, points held US ([0-9]+) RU ([0-9]+), neither ([0-9]+), captures ([0-9]+), ConquestState messages ([0-9]+)")
    message(FATAL_ERROR "${ROW}: no conquest summary line")
endif()
set(us ${CMAKE_MATCH_1})
set(us_of ${CMAKE_MATCH_2})
set(ru ${CMAKE_MATCH_3})
set(ru_of ${CMAKE_MATCH_4})
set(held_us ${CMAKE_MATCH_5})
set(held_ru ${CMAKE_MATCH_6})
set(held_none ${CMAKE_MATCH_7})
set(captures ${CMAKE_MATCH_8})
if(NOT us_of EQUAL TICKETS OR NOT ru_of EQUAL TICKETS)
    string(APPEND failures " initial-tickets-${us_of}-${ru_of}-not-${TICKETS}")
endif()
math(EXPR spent "${us_of} - ${us} + ${ru_of} - ${ru}")
if(SPEND AND spent LESS 1)
    string(APPEND failures " no-ticket-spent")
endif()
math(EXPR points "${held_us} + ${held_ru} + ${held_none}")
if(points LESS 3 OR held_us LESS 1 OR held_ru LESS 1)
    string(APPEND failures " points-${held_us}-${held_ru}-${held_none}")
endif()
if(NOT out MATCHES "\\[dedicated\\] conquest: tickets US ")
    string(APPEND failures " no-once-a-second-conquest-line")
endif()
if(NOT out MATCHES "summary: [^\n]*, install unchanged,")
    string(APPEND failures " install")
endif()
message("${ROW}: ${LEVEL} ${MODE}: tickets US ${us} of ${us_of}, RU ${ru} of ${ru_of}; points held US ${held_us} RU ${held_ru}, neither ${held_none}; captures ${captures}")
if(NOT failures STREQUAL "")
    message(FATAL_ERROR "${ROW} failed:${failures}")
endif()
message("DEDICATED CONQUEST: PASS")
