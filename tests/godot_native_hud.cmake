cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef tag)
set(shots "$ENV{OPENBF3_NATIVE_HUD_SHOTS}")
if(shots STREQUAL "")
    set(shots "${BUILD_DIR}/shots/native_hud-${tag}")
endif()
set(cache_args "")
if(DEFINED BUILD_DIR AND NOT BUILD_DIR STREQUAL "")
    file(MAKE_DIRECTORY "${BUILD_DIR}/godot-cache/godot.native_hud")
    set(cache_args "--bf3-cache=${BUILD_DIR}/godot-cache/godot.native_hud")
endif()
message("moment captures: ${shots}")
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 115
    ARGS --path "${PROJECT_DIR}" --resolution 1280x720 res://scenes/metro_tdm.tscn -- --bots=0 --deploy-screen=0 --preround=0 --min-players=1
        "--native-hud-moments=${shots}" --native-hud-ids=m02,m10,m13 ${cache_args})
godot_require_pass("NATIVE HUD MOMENTS: PASS")
godot_require_pass("\\[level\\] install unchanged: yes")
