cmake_minimum_required(VERSION 3.29)
if(NOT SOURCE_DIR)
    message(FATAL_ERROR "test_scratch_paths: SOURCE_DIR=<checkout> is required")
endif()
set(helpers tests/test_scratch.cpp tests/test_scratch.h tests/test_scratch.cmake tests/test_scratch_paths.cmake)
set(pattern "temp_directory_path|GetTempPath|GetTempFileName|[$]ENV[{](TEMP|TMP)[}]|%(TEMP|TMP)%|[$]env:(TEMP|TMP)|tmpnam[(]|tmpfile[(]|mkstemp[(]|mkdtemp[(]|tempfile[.]|gettempdir|get_temp_dir")
file(GLOB_RECURSE sources RELATIVE "${SOURCE_DIR}" LIST_DIRECTORIES false
    "${SOURCE_DIR}/tests/*" "${SOURCE_DIR}/tools/*")
set(found 0)
set(scanned 0)
foreach(rel IN LISTS sources)
    if(rel IN_LIST helpers OR NOT rel MATCHES "[.](cpp|h|cmake|txt|cmd|bat|ps1|py|gd)$")
        continue()
    endif()
    math(EXPR scanned "${scanned} + 1")
    file(STRINGS "${SOURCE_DIR}/${rel}" lines REGEX "${pattern}")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        message("${rel}: a temp path outside the test scratch helper: ${line}")
        math(EXPR found "${found} + 1")
    endforeach()
endforeach()
if(found GREATER 0)
    message(FATAL_ERROR "test.scratch.paths: ${found} temp path(s) outside tests/test_scratch.h and tests/test_scratch.cmake in ${scanned} test and tool sources")
endif()
message("test.scratch.paths: PASS (${scanned} test and tool sources, every scratch folder through the helper)")
