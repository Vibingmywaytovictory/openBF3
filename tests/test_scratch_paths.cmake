cmake_minimum_required(VERSION 3.29)
if(NOT SOURCE_DIR)
    message(FATAL_ERROR "test_scratch_paths: SOURCE_DIR=<checkout> is required")
endif()
set(helpers tests/test_scratch.cpp tests/test_scratch.h tests/test_scratch.cmake tests/test_scratch_paths.cmake)
set(helper_tests tests/test_scratch_tests.cpp)
set(root_pattern "(^|[^A-Za-z0-9_])(temp_dir|scratch_root)[(]")
set(pattern "temp_directory_path|GetTempPath|GetTempFileName|ENV[{](TEMP|TMP)[}]|%(TEMP|TMP)%|[$]env:(TEMP|TMP)|(getenv|_dupenv_s|GetEnvironmentVariable[AW]?|get_environment)[ (].*\"(TEMP|TMP|TMPDIR)\"|tmpnam[(]|tmpfile[(]|mkstemp[(]|mkdtemp[(]|(^|[^A-Za-z0-9_])tempfile([^A-Za-z0-9_]|$)|os[.]environ.*['\"](TEMP|TMP|TMPDIR)['\"]|gettempdir|get_temp_dir|(BUILD_DIR|CMAKE_BINARY_DIR)[}]/scratch([^-A-Za-z0-9_.]|$)")
file(GLOB_RECURSE sources RELATIVE "${SOURCE_DIR}" LIST_DIRECTORIES false
    "${SOURCE_DIR}/tests/*" "${SOURCE_DIR}/tools/*" "${SOURCE_DIR}/src/*")
set(found 0)
set(scanned 0)
foreach(rel IN LISTS sources)
    if(rel IN_LIST helpers OR NOT rel MATCHES "[.](cpp|h|cmake|txt|cmd|bat|ps1|py|gd)$")
        continue()
    endif()
    math(EXPR scanned "${scanned} + 1")
    set(rel_pattern "${pattern}")
    if(NOT rel IN_LIST helper_tests)
        string(APPEND rel_pattern "|${root_pattern}")
    endif()
    file(STRINGS "${SOURCE_DIR}/${rel}" lines REGEX "${rel_pattern}")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        message("${rel}: a scratch path outside the test scratch helper: ${line}")
        math(EXPR found "${found} + 1")
    endforeach()
endforeach()
if(found GREATER 0)
    message(FATAL_ERROR "test.scratch.paths: ${found} temp or build-directory scratch path(s) outside tests/test_scratch.h and tests/test_scratch.cmake in ${scanned} sources of tests/, tools/ and src/")
endif()
message("test.scratch.paths: PASS (${scanned} sources of tests/, tools/ and src/, every scratch folder through the helper)")
