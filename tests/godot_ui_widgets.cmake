cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(shots "$ENV{OPENBF3_UI_WIDGETS_SHOTS}")
if(shots STREQUAL "")
    set(shots "${BUILD_DIR}/shots/ui_widgets")
endif()
file(TO_CMAKE_PATH "${shots}" shots)
file(MAKE_DIRECTORY "${shots}")
set(pngs widgets_scoreboard32.png widgets_scoreboard32_hud.png widgets_popupgeneric.png widgets_popupgeneric_hud.png)
foreach(png ${pngs})
    file(REMOVE "${shots}/${png}")
endforeach()
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 110 ARGS --path "${PROJECT_DIR}" res://scenes/ui_widgets.tscn -- "--shot-dir=${shots}")
set(missing "")
foreach(png ${pngs})
    if(NOT EXISTS "${shots}/${png}")
        string(APPEND missing " ${png}")
    endif()
endforeach()
godot_require_pass("WIDGET SHOTS CHECK: PASS" "; missing:${missing}")
if(NOT missing STREQUAL "")
    message(FATAL_ERROR "${ROW} failed (exit ${rc}; missing:${missing})")
endif()
message("shots: ${shots}")
