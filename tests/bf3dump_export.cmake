cmake_minimum_required(VERSION 3.29)

foreach(_var BF3DUMP KIND SCRATCH CONSUMER)
    if(NOT ${_var})
        message(FATAL_ERROR "bf3dump_export: ${_var} is required")
    endif()
endforeach()

string(RANDOM LENGTH 12 _salt)
set(_dir "${SCRATCH}/export-${KIND}-${_salt}")
file(MAKE_DIRECTORY "${_dir}")

function(fail _what)
    file(REMOVE_RECURSE "${_dir}")
    message(STATUS "tools.export.${KIND}: FAIL: ${_what}")
    cmake_language(EXIT 1)
endfunction()

function(run_export)
    execute_process(COMMAND "${BF3DUMP}" export ${ARGN} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 300)
    if(_rc EQUAL 77)
        file(REMOVE_RECURSE "${_dir}")
        message(STATUS "tools.export.${KIND}: no install: ${_err}")
        cmake_language(EXIT 77)
    endif()
    string(REGEX MATCH "export [^\n]*" _summary "${_err}")
    message(STATUS "${_summary}")
    if(NOT _rc EQUAL 0)
        fail("bf3dump export ${ARGN} exited ${_rc}\n${_err}")
    endif()
endfunction()

function(run_consumer _env _expect_cases)
    execute_process(COMMAND ${CMAKE_COMMAND} -E env "${_env}=${_dir}" ${ARGN} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 300)
    string(REGEX MATCH "test cases: *[0-9]+ \\| *[0-9]+ passed[^\n]*" _cases "${_out}")
    message(STATUS "${ARGN}: exit ${_rc}, ${_cases}")
    if(NOT _rc EQUAL 0 OR _out MATCHES "SKIPPED" OR _out MATCHES "NOT RUN: the install-vs-export")
        fail("${ARGN} with ${_env} exited ${_rc}\n${_out}\n${_err}")
    endif()
    if(NOT _expect_cases STREQUAL "" AND NOT _cases MATCHES "^test cases: *${_expect_cases} \\| *${_expect_cases} passed")
        fail("${ARGN}: expected ${_expect_cases} passing cases, got ${_cases}")
    endif()
endfunction()

if(KIND STREQUAL "cache")
    run_export(cache Win32/Levels/MP_Subway/MP_Subway "${_dir}" 16)
    run_consumer(OPENBF3_CACHE_TESTDATA 1 "${CONSUMER}" --test-suite=cache_data)
elseif(KIND STREQUAL "res")
    if(NOT RESDUMP)
        message(FATAL_ERROR "bf3dump_export: RESDUMP is required for res")
    endif()
    run_export(res Win32/Levels/MP_Subway/MP_Subway subway "${_dir}"
        weapons/m9/m9_1p_mesh
        weapons/m9/m9_d
        characters/arms/arms1p_bareglove03/arms1p_bareglove03_mesh
        architecture/parisceiling_01/parisceiling_01_physics_0_win32
        architecture/parisstairwell_01/parisstairwell_facade_02_destruction_physics_0_win32
        levels/mp_subway/objects/parkentrance/parkentranceundestroyed_physics_0_win32)
    run_consumer(OPENBF3_RES_DATA 4 "${CONSUMER}" --test-suite=res "--test-case-exclude=res: whole sample decodes")
    execute_process(COMMAND "${RESDUMP}" "${_dir}" subway RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 300)
    string(REGEX MATCHALL "\n== [^\n]*" _heads "\n${_out}")
    list(LENGTH _heads _count)
    message(STATUS "resdump over the export: exit ${_rc}, ${_count} res")
    if(NOT _rc EQUAL 0 OR NOT _count EQUAL 6)
        fail("resdump over the export: exit ${_rc}, ${_count} res\n${_err}")
    endif()
elseif(KIND STREQUAL "ant")
    if(NOT ANTDUMP)
        message(FATAL_ERROR "bf3dump_export: ANTDUMP is required for ant")
    endif()
    run_export(ant "${_dir}")
    run_consumer(OPENBF3_ANT_DATA "" "${CONSUMER}" --test-suite=ant)
    execute_process(COMMAND "${ANTDUMP}" parity "${_dir}" --install RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 300)
    string(REGEX MATCH "payloads:[^\n]*" _payloads "${_out}")
    message(STATUS "antdump parity: exit ${_rc}, ${_payloads}")
    if(NOT _rc EQUAL 0 OR NOT _out MATCHES "PARITY OK")
        fail("antdump parity exited ${_rc}\n${_out}\n${_err}")
    endif()
else()
    fail("unknown KIND ${KIND}")
endif()

file(REMOVE_RECURSE "${_dir}")
message(STATUS "tools.export.${KIND}: PASS")
