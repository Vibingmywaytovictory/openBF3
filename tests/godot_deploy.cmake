cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
if(NOT DEFINED PHASE OR PHASE STREQUAL "")
    message(FATAL_ERROR "${ROW}: -DPHASE=loadout|gadget|squad|scope|optic is required")
endif()
set(optic_args "")
if(PHASE STREQUAL "optic")
    if(NOT DEFINED OPTIC OR OPTIC STREQUAL "")
        message(FATAL_ERROR "${ROW}: -DPHASE=optic needs -DOPTIC=<optic unlock name>")
    endif()
    set(optic_args "--deploy-optic=${OPTIC}")
endif()
set(cache_args "")
set(shot_args "")
if(DEFINED BUILD_DIR AND NOT BUILD_DIR STREQUAL "")
    file(MAKE_DIRECTORY "${BUILD_DIR}/godot-cache/godot.deploy")
    set(cache_args "--bf3-cache=${BUILD_DIR}/godot-cache/godot.deploy")
    set(shots "${BUILD_DIR}/shots/${ROW}")
    file(REMOVE_RECURSE "${shots}")
    file(MAKE_DIRECTORY "${shots}")
    set(shot_args "--deploy-shots=${shots}")
endif()
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 170
    ARGS --path "${PROJECT_DIR}" --resolution 1280x720 res://scenes/metro_tdm.tscn -- --bots=0 --deploy-screen=1 --preround=0 --min-players=1
        --deploy-check "--deploy-phase=${PHASE}" ${optic_args} ${cache_args} ${shot_args})
godot_require_pass("DEPLOY: PASS")
godot_require_pass("\\[level\\] install unchanged: yes")
