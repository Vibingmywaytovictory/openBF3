cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(cache "${BUILD_DIR}/godot-cache/${ROW}")
set(shots "${BUILD_DIR}/shots/${ROW}")
file(MAKE_DIRECTORY "${cache}" "${shots}")
set(netsim "")
if(DEFINED NETSIM)
    set(netsim "--netsim=${NETSIM}")
endif()
set(audio_args)
set(zoom_args)
if(ZOOM)
    set(zoom_args --vehicle-zoom)
endif()
set(level_args --level=MP_007 --mode=ConquestSmall0)
set(timeout 170)
if(IFV)
    set(level_args --level=MP_003 --mode=ConquestSmall0 --vehicle-ifv)
    set(timeout 230)
endif()
if(AUDIO)
    set(audio_args "--audio-capture=${shots}/audio")
endif()
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT ${timeout}
    ARGS --path "${PROJECT_DIR}" --resolution 1280x720 res://scenes/metro_tdm.tscn -- ${level_args}
        --bots=0 --deploy-screen=0 --preround=0 --min-players=1 --vehicle-drive "--vehicle-shots=${shots}" ${netsim}
        "--bf3-cache=${cache}" ${audio_args} ${zoom_args})
godot_require_pass("VEHICLE DRIVE: PASS")
godot_require_pass("\\[level\\] install unchanged: yes")
if(NOT out MATCHES "\\[game\\] vehicles built: [^\n]*; ([0-9]+) materials drawn through their shader's program, ([0-9]+) through the resolved look")
    message(FATAL_ERROR "${ROW}: no vehicle material counts")
endif()
message("${ROW}: ${CMAKE_MATCH_1} vehicle materials through their shader's program, ${CMAKE_MATCH_2} through the resolved look")
if(NOT CMAKE_MATCH_1 EQUAL PROGRAM_MATERIALS OR NOT CMAKE_MATCH_2 EQUAL LOOK_MATERIALS)
    message(FATAL_ERROR "${ROW}: the level's vehicles draw ${PROGRAM_MATERIALS} materials through their programs and "
        "${LOOK_MATERIALS} through looks")
endif()
godot_require_pass("\\[game\\] effect lights: [0-9]+ frames, at most [1-9][0-9]* light particles[^\n]*, 0 effect lights brighter than their data")
if(ZOOM)
    godot_require_pass("VEHICLE DRIVE ROW tank_drive PASS")
    godot_require_pass("VEHICLE DRIVE ROW tank_turn PASS")
    godot_require_pass("VEHICLE DRIVE ROW tank_main_gun PASS")
    godot_require_pass("VEHICLE DRIVE ROW tank_gunner PASS")
endif()
if(IFV)
    godot_require_pass("VEHICLE DRIVE ROW ifv_main_gun PASS")
    godot_require_pass("VEHICLE DRIVE ROW ifv_gunner PASS")
else()
    godot_require_pass("VEHICLE DRIVE ROW exit_fire PASS")
    godot_require_pass("VEHICLE DRIVE ROW exit_switch PASS")
endif()
if(AUDIO)
    godot_require_pass("\\[audio\\] vehicle engines: [1-9][0-9]* patches, [1-9][0-9]* starts, [0-9]+ stops, [0-9]+ ended, [1-9][0-9]* updates, peak [1-9][0-9]* live, [1-9][0-9]* interior frames, 0 push failures, 0 create failures")
endif()
