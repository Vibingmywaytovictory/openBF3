cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(shots "$ENV{OPENBF3_UI_EFFECTS_SHOTS}")
if(shots STREQUAL "")
    set(shots "${BUILD_DIR}/shots/ui_effects")
endif()
file(TO_CMAKE_PATH "${shots}" shots)
file(MAKE_DIRECTORY "${shots}")
set(cache_args "")
if(DEFINED BUILD_DIR AND NOT BUILD_DIR STREQUAL "")
    file(MAKE_DIRECTORY "${BUILD_DIR}/godot-cache/godot.ui_effects")
    set(cache_args "--bf3-cache=${BUILD_DIR}/godot-cache/godot.ui_effects")
endif()
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 170
    ARGS --path "${PROJECT_DIR}" --resolution 1280x720 res://scenes/ui_effects.tscn -- --bots=0 --deploy-screen=0 --preround=0 --min-players=1
        "--shot-dir=${shots}" ${cache_args})
godot_require_pass("UI EFFECTS CHECK: PASS")
godot_require_pass("\\[level\\] install unchanged: yes")
message("shots: ${shots}")
