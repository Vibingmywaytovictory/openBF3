cmake_minimum_required(VERSION 3.29)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)

file(READ "${SERVER_CMD}" server_cmd_text)
if(NOT server_cmd_text MATCHES "--headless --path")
    message(FATAL_ERROR "${ROW}: tools/server.cmd does not start Godot --headless")
endif()

set(root "${BUILD_DIR}/scratch/${ROW}")
set(project "${root}/bf3-opensource-server")
set(list_file "${project}/.godot/extension_list.cfg")
file(REMOVE_RECURSE "${root}")
file(COPY "${SERVER_CMD}" DESTINATION "${root}/tools")
file(COPY "${PROJECT_DIR}/project.godot" "${PROJECT_DIR}/server.tscn" "${PROJECT_DIR}/openbf3_server.gdextension"
    DESTINATION "${project}")
file(COPY "${SERVER_DLL}" DESTINATION "${project}/bin")
file(APPEND "${project}/project.godot" "\n[debug]\n\nfile_logging/enable_file_logging.pc=false\n")
set(ENV{OPENBF3_GODOT} "${godot}")
set(godot "${root}/tools/server.cmd")

godot_run(TIMEOUT 30 HEADER "a project never started, no extension list" ARGS -- --dedicated-seconds=1)
if(NOT EXISTS "${list_file}")
    message(FATAL_ERROR "${ROW}: server.cmd left no ${list_file} (exit ${rc})")
endif()
file(STRINGS "${list_file}" listed)
if(NOT listed STREQUAL "res://openbf3_server.gdextension")
    message(FATAL_ERROR "${ROW}: ${list_file} lists '${listed}'")
endif()
if(NOT out MATCHES "\\[dedicated\\] extensions res://openbf3_server\\.gdextension, classes DedicatedMainLoop[\r\n]")
    message(FATAL_ERROR "${ROW}: the server did not start from the list server.cmd wrote (exit ${rc})")
endif()
if(NOT out MATCHES "\\[dedicated\\] failed: the config directory openbf3/config/dir = res://\\.\\./bf3-opensource/config \\([^\n]*\\) does not exist")
    message(FATAL_ERROR "${ROW}: a missing config directory is not a start-up failure")
endif()

file(GLOB server_dlls "${project}/bin/*.dll")
file(REMOVE ${server_dlls})
godot_run(TIMEOUT 30 HEADER "no server DLL" ARGS -- --dedicated-seconds=1)
if(NOT rc STREQUAL "2" OR NOT out MATCHES "server\\.cmd: no server extension in ")
    message(FATAL_ERROR "${ROW}: server.cmd without the server DLL (exit ${rc})")
endif()

file(REMOVE_RECURSE "${root}")
message("SERVER_CMD: PASS")
