cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
openbf3_scratch_dir(scratch godot-surface-decals)
set(root "${scratch}/cache")
set(y 68.9425)
set(points
    "-73.903,${y},-50.527;-71.050,${y},-50.527;-71.050,${y},-47.675;-73.903,${y},-47.675"
    "-83.675,${y},-59.137;-80.822,${y},-59.137;-80.822,${y},-56.285;-83.675,${y},-56.285"
    "-59.920,${y},-86.065;-57.067,${y},-86.065;-57.067,${y},-83.213;-59.920,${y},-83.213"
    "-50.304,${y},-77.693;-47.451,${y},-77.693;-47.451,${y},-74.840;-50.304,${y},-74.840")
list(JOIN points "\;" points_arg)
if(NOT DEFINED VIEWS)
    set(VIEWS "a_top74@-72.5,74,-49.1,0,-85|a_top76@-72.5,76,-49.1,0,-85|a_top72@-72.5,72,-49.1,0,-85|a_steep74@-72.5,74,-51.5,0,-65|a_eye@-72.5,70.5,-51.6,0,-35|b_nw@-82.25,73,-55.7,180,-65|c_eye@-58.5,70.5,-87.1,0,-35|d_s@-48.9,70.5,-78.8,0,-35")
endif()
string(REPLACE "|" ";" views "${VIEWS}")
set(failed FALSE)
foreach(pass on lifted off)
    set(shots "${scratch}/${pass}")
    file(MAKE_DIRECTORY "${shots}")
    set(list "")
    foreach(view IN LISTS views)
        string(REPLACE "@" ".png@" view "${view}")
        list(APPEND list "${shots}/${view}")
    endforeach()
    list(JOIN list "\;" shot_arg)
    set(look_args "")
    if(pass STREQUAL "lifted")
        set(look_args "--look-off=surface_decal_lift")
    elseif(pass STREQUAL "off")
        set(look_args "--look-off=surface_decals")
    endif()
    godot_run(QUIET SKIP_WITHOUT_INSTALL TIMEOUT 300 REMOVE_ON_SKIP "${root}"
        ARGS --path "${PROJECT_DIR}" --resolution 1280x720 res://scenes/m1_metro.tscn -- --level=MP_Subway --mode=ConquestLarge0
            "--bf3-cache=${root}" --no-hud --shot-settle=2 "--shots=${shot_arg}" "--shot-points=${points_arg}" ${look_args}
            --quit-after=1)
    set(text "${out}\n${err}")
    string(REGEX MATCHALL "\\[m1\\] shot points [^\n]*" lines "${text}")
    list(LENGTH lines n)
    list(LENGTH views want)
    if(NOT rc STREQUAL "0" OR NOT n EQUAL want)
        message("${out}")
        message("${err}")
        message("${ROW} ${pass}: exit ${rc}, ${n} of ${want} shots placed")
        set(failed TRUE)
    endif()
    if(NOT text MATCHES "\\[level\\] terrain surface decals: 2 of 2 records drawn")
        message("${ROW} ${pass}: Metro's surface decals are not planned")
        set(failed TRUE)
    endif()
    if(pass STREQUAL "on")
        set(table "")
        foreach(line IN LISTS lines)
            string(REGEX REPLACE "^\\[m1\\] shot points .*/([^/]+\\.png): (.*)$" "\\1|\\2" row "${line}")
            string(APPEND table "${row}\n")
        endforeach()
        file(WRITE "${scratch}/points.txt" "${table}")
    endif()
endforeach()
if(NOT failed)
    execute_process(COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/surface_decal_shots.py" "${MAX_HIDDEN}" "${scratch}/on"
            "${scratch}/lifted" "${scratch}/off" "${scratch}/points.txt"
        RESULT_VARIABLE shots_rc OUTPUT_VARIABLE shots_out ERROR_VARIABLE shots_err)
    message("${shots_out}${shots_err}")
    if(NOT shots_rc STREQUAL "0")
        message("${ROW}: the terrain covers part of a tree grating in a shot")
        set(failed TRUE)
    endif()
endif()
if(NOT "$ENV{OPENBF3_TERRAIN_SHOTS}" STREQUAL "")
    file(TO_CMAKE_PATH "$ENV{OPENBF3_TERRAIN_SHOTS}" keep)
    file(COPY "${scratch}/on" "${scratch}/lifted" "${scratch}/off" DESTINATION "${keep}")
endif()
openbf3_scratch_remove_all()
if(failed)
    message(FATAL_ERROR "godot.surface_decals: FAIL")
endif()
message("godot.surface_decals: PASS")
