cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)

godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 200 ARGS --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn --
    --level=MP_007 --mode=ConquestLarge0 --bots=0 --preround=0 --quit-after=${QUIT_AFTER}
    --logic-networked=4b645d9fca970719@${INJECT_AT} ${godot_cache_args})

set(failures "")
if(NOT out MATCHES "\\[game\\] logic networked event 4b645d9fca970719 delivered to the client logic")
    string(APPEND failures " not-delivered")
endif()
if(NOT out MATCHES "\\[game\\] placed effects: 338 placed, [^\r\n]* ([0-9]+) bound to the client logic, ([0-9]+) logic starts, ([0-9]+) logic stops, ([0-9]+) started by logic")
    string(APPEND failures " no-logic-placed-effects-line")
else()
    if(NOT CMAKE_MATCH_1 EQUAL 338)
        string(APPEND failures " bound-${CMAKE_MATCH_1}-of-338")
    endif()
    if(NOT CMAKE_MATCH_2 EQUAL 14)
        string(APPEND failures " logic-starts-${CMAKE_MATCH_2}-not-14")
    endif()
    if(NOT CMAKE_MATCH_4 EQUAL 14)
        string(APPEND failures " started-by-logic-${CMAKE_MATCH_4}-not-14")
    endif()
endif()
if(failures)
    message(FATAL_ERROR "${ROW}:${failures}")
endif()
message("${ROW}: PASS")
