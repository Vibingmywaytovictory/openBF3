# tools.tc_cost (track "Terrain collision everywhere", gate G3; docs/design/terrain-collision.md §2, §4.4, §4.5):
# `bf3dump shapes <L> <M> --cache=<fresh scratch root>` cold, then twice warm (each run its own process) for
# MP_Subway TeamDeathMatch0, XP3_Shield RushLarge0 and XP3_Alborz SquadRush0. Parses "shapes total", "peak working
# set", "peak private bytes", "resident" and "cache" and checks the §4.5 limits:
#   Shield RL, Alborz SR: cold <= 6.0 s, warm <= 0.5 s; cold peak working set and private bytes <= 1536 MiB, warm
#                         <= 512 MiB; resident <= 150 MiB; cache (read or written by the cold run) <= 160 MiB
#   Metro TDM:            cold <= 1.4 s, warm <= 0.1 s; cold peak <= 614.4 MiB, warm peak <= 307.2 MiB; resident
#                         <= 30 MiB; cache <= 40 MiB
# Every run must print install.unchanged yes. Prints the before / after table (§4.4 before). Timings are noisy on a
# shared machine: take it under the quiet lock. Exits 77 (skipped) when bf3dump finds no install.
# Usage: cmake -DBF3DUMP=<bf3dump.exe> [-DREPORT_ONLY=ON] -P tc_cost.cmake (report-only: the asan preset)
cmake_minimum_required(VERSION 3.29)

if(NOT BF3DUMP OR NOT EXISTS "${BF3DUMP}")
    message(FATAL_ERROR "tc_cost: BF3DUMP=<bf3dump.exe> is required")
endif()

set(_failed 0)
macro(report _ok _what)
    if(${_ok})
        message(STATUS "  ok    ${_what}")
    elseif(REPORT_ONLY)
        message(STATUS "  info  ${_what} (report only)")
    else()
        message(STATUS "  FAIL  ${_what}")
        set(_failed 1)
    endif()
endmacro()

# parse(<output> <prefix>): <prefix>_TOTAL, _WS, _PRIV, _RES, _CACHE, _UNCHANGED.
function(parse _out _p)
    string(REGEX MATCH "shapes total ([0-9.]+) s" _m "${_out}")
    set(${_p}_TOTAL "${CMAKE_MATCH_1}" PARENT_SCOPE)
    string(REGEX MATCH "peak working set ([0-9.]+) MiB, peak private bytes ([0-9.]+) MiB" _m "${_out}")
    set(${_p}_WS "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(${_p}_PRIV "${CMAKE_MATCH_2}" PARENT_SCOPE)
    string(REGEX MATCH "resident ([0-9.]+) MiB \\(Jolt GetStats\\), cache ([0-9.]+) MiB" _m "${_out}")
    set(${_p}_RES "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(${_p}_CACHE "${CMAKE_MATCH_2}" PARENT_SCOPE)
    string(REGEX MATCH "shapes   (world hit|world miss)" _m "${_out}")
    set(${_p}_WORLD "${CMAKE_MATCH_1}" PARENT_SCOPE)
    string(REGEX MATCH "shapes   terrain ([0-9]+) fields \\(([0-9]+) hit, ([0-9]+) cooked\\)" _m "${_out}")
    set(${_p}_TERRAINS "${CMAKE_MATCH_1}/${CMAKE_MATCH_2} hit/${CMAKE_MATCH_3} cooked" PARENT_SCOPE)
    string(FIND "${_out}" "install.unchanged yes" _at)
    if(_at GREATER -1)
        set(${_p}_UNCHANGED TRUE PARENT_SCOPE)
    else()
        set(${_p}_UNCHANGED FALSE PARENT_SCOPE)
    endif()
endfunction()

function(le _a _b _out)
    if(NOT "${_a}" STREQUAL "" AND "${_a}" LESS_EQUAL "${_b}")
        set(${_out} TRUE PARENT_SCOPE)
    else()
        set(${_out} FALSE PARENT_SCOPE)
    endif()
endfunction()

file(TO_CMAKE_PATH "$ENV{TEMP}" _temp)
set(_table "")
# level mode cold_s warm_s cold_peak_mib warm_peak_mib resident_mib cache_mib before
set(_runs
    "MP_Subway|TeamDeathMatch0|1.4|0.1|614.4|307.2|30|40|0.681 s; 293.1 / 308.2 MiB; warm 0.036 s; 22.6 MiB"
    "XP3_Shield|RushLarge0|6.0|0.5|1536|512|150|160|2.876 s; 549.9 / 676.6 MiB; warm 0.092 s; 72.6 MiB"
    "XP3_Alborz|SquadRush0|6.0|0.5|1536|512|150|160|2.513 s; 644.7 / 710.6 MiB; warm 0.054 s; 78.3 MiB")
foreach(_run IN LISTS _runs)
    string(REPLACE "|" ";" _f "${_run}")
    list(GET _f 0 _level)
    list(GET _f 1 _mode)
    list(GET _f 2 _cold_limit)
    list(GET _f 3 _warm_limit)
    list(GET _f 4 _cold_peak_limit)
    list(GET _f 5 _warm_peak_limit)
    list(GET _f 6 _res_limit)
    list(GET _f 7 _cache_limit)
    list(GET _f 8 _before)
    string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" _tag)
    set(_root "${_temp}/o3c-${_tag}")
    file(REMOVE_RECURSE "${_root}")
    file(TO_NATIVE_PATH "${_root}" _root_native)
    foreach(_pass cold warm1 warm2)
        execute_process(COMMAND "${BF3DUMP}" shapes ${_level} ${_mode} "--cache=${_root_native}"
            RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 300)
        if(_rc EQUAL 77)
            message(STATUS "tc_cost: no install (bf3dump exit 77): ${_err}")
            file(REMOVE_RECURSE "${_root}")
            cmake_language(EXIT 77)
        endif()
        message(STATUS "---- ${_level} ${_mode} ${_pass} (exit ${_rc}) ----\n${_out}")
        if(NOT _rc EQUAL 0)
            message(STATUS "${_err}")
            set(_failed 1)
        endif()
        parse("${_out}" P)
        set(${_pass}_TOTAL "${P_TOTAL}")
        set(${_pass}_WS "${P_WS}")
        set(${_pass}_PRIV "${P_PRIV}")
        set(${_pass}_RES "${P_RES}")
        set(${_pass}_CACHE "${P_CACHE}")
        set(${_pass}_WORLD "${P_WORLD}")
        set(${_pass}_TERRAINS "${P_TERRAINS}")
        report(P_UNCHANGED "${_level} ${_mode} ${_pass}: install.unchanged")
    endforeach()
    file(REMOVE_RECURSE "${_root}")
    message(STATUS "tools.tc_cost ${_level} ${_mode}:")
    if("${cold_WORLD}" STREQUAL "world miss" AND "${warm1_WORLD}" STREQUAL "world hit" AND "${warm2_WORLD}" STREQUAL "world hit")
        set(_ok TRUE)
    else()
        set(_ok FALSE)
    endif()
    report(_ok "cold misses the world, both warm runs hit it (terrains: cold ${cold_TERRAINS}, warm ${warm1_TERRAINS})")
    le("${cold_TOTAL}" "${_cold_limit}" _ok)
    report(_ok "cold shapes total ${cold_TOTAL} s <= ${_cold_limit} s")
    foreach(_w warm1 warm2)
        le("${${_w}_TOTAL}" "${_warm_limit}" _ok)
        report(_ok "${_w} shapes total ${${_w}_TOTAL} s <= ${_warm_limit} s")
    endforeach()
    le("${cold_WS}" "${_cold_peak_limit}" _ok)
    report(_ok "cold peak working set ${cold_WS} MiB <= ${_cold_peak_limit} MiB")
    le("${cold_PRIV}" "${_cold_peak_limit}" _ok)
    report(_ok "cold peak private bytes ${cold_PRIV} MiB <= ${_cold_peak_limit} MiB")
    foreach(_w warm1 warm2)
        le("${${_w}_WS}" "${_warm_peak_limit}" _ok)
        report(_ok "${_w} peak working set ${${_w}_WS} MiB <= ${_warm_peak_limit} MiB")
        le("${${_w}_PRIV}" "${_warm_peak_limit}" _ok)
        report(_ok "${_w} peak private bytes ${${_w}_PRIV} MiB <= ${_warm_peak_limit} MiB")
    endforeach()
    le("${cold_RES}" "${_res_limit}" _ok)
    report(_ok "resident ${cold_RES} MiB <= ${_res_limit} MiB (warm ${warm1_RES} MiB)")
    le("${cold_CACHE}" "${_cache_limit}" _ok)
    report(_ok "cache ${cold_CACHE} MiB written by the cold run <= ${_cache_limit} MiB")
    string(APPEND _table "| ${_level} ${_mode} | ${cold_TOTAL} s; ${cold_WS} / ${cold_PRIV} MiB | ${warm1_TOTAL} s; ${warm1_WS} / ${warm1_PRIV} MiB | ${warm2_TOTAL} s; ${warm2_WS} / ${warm2_PRIV} MiB | ${cold_RES} MiB | ${cold_CACHE} MiB | before: ${_before} |\n")
endforeach()

message(STATUS "tools.tc_cost table (after TC | cold | warm 1 | warm 2 | resident | cache | before TC, docs §4.4):\n${_table}")
if(_failed)
    message(STATUS "tools.tc_cost: FAIL")
    cmake_language(EXIT 1)
endif()
message(STATUS "tools.tc_cost: PASS")
