cmake_minimum_required(VERSION 3.25)
string(REPLACE "," ";" ALLOWED "${ALLOWED}")
if(NOT EXISTS "${MAP}" OR NOT EXISTS "${DLL}")
    message(FATAL_ERROR "build.server_deps: the server DLL ${DLL} or its link map ${MAP} is missing (build the preset first)")
endif()
file(STRINGS "${MAP}" lines REGEX " [A-Za-z0-9_.-]+:[^ ]+\\.obj$")
set(libraries "")
foreach(line IN LISTS lines)
    if(line MATCHES " ([A-Za-z0-9_.-]+):[^ ]+\\.obj$")
        list(APPEND libraries "${CMAKE_MATCH_1}")
    endif()
endforeach()
list(REMOVE_DUPLICATES libraries)
list(SORT libraries)
list(JOIN libraries ", " libraries_text)
message("build.server_deps: ${DLL} holds code from ${libraries_text}")
if(NOT "bf3_host" IN_LIST libraries OR NOT libraries MATCHES "(^|;)libgodot-cpp[.]")
    message(FATAL_ERROR "build.server_deps: no code from bf3_host and godot-cpp in ${MAP}; it is not a GDExtension's link map")
endif()
set(outside "")
foreach(library IN LISTS libraries)
    if(library MATCHES "^bf3_" AND NOT library IN_LIST ALLOWED)
        string(APPEND outside " ${library}")
    endif()
endforeach()
if(NOT outside STREQUAL "")
    message(FATAL_ERROR "build.server_deps: the dedicated server's DLL holds code from libraries outside the server's set:${outside}")
endif()
message("build.server_deps: PASS")
