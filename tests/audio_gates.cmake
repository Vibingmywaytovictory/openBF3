# M2a audio install gates driven by bf3dump (docs/design/m2a-audio.md §1, §10.2): each runs one `bf3dump audio ...`
# command, parses its summary line (key=value pairs) and checks the gate's thresholds; every one also requires the
# command's `install.unchanged yes` line and exit 0. Exits 77 (skipped) when bf3dump finds no install.
#   GATE=waves         G1 audio.waves         bf3dump audio waves MP_Subway TeamDeathMatch0 --decode
#   GATE=loc           G2 audio.loc           bf3dump audio loc en --decode
#   GATE=decode_perf   G3 audio.decode.perf   bf3dump audio waves MP_Subway TeamDeathMatch0 --bench 3
#   GATE=census        G4 audio.census        bf3dump audio census @all-mp
#   GATE=bank          G6 audio.bank          bf3dump audio bank MP_Subway TeamDeathMatch0 --loads 2
#   GATE=m16_offline   G7 audio.m16.offline   bf3dump audio check --g7 --out-dir <SHOTS>
# Usage: cmake -DBF3DUMP=<bf3dump.exe> -DGATE=<gate> [-DSHOTS=<dir>] [-DREPORT_ONLY=ON] -P audio_gates.cmake
cmake_minimum_required(VERSION 3.29)

if(NOT BF3DUMP OR NOT EXISTS "${BF3DUMP}")
    message(FATAL_ERROR "audio_gates: BF3DUMP=<bf3dump.exe> is required")
endif()

set(_failed 0)

# Runs bf3dump with the given arguments; sets _out (stdout) in the caller.
macro(run_bf3dump)
    execute_process(COMMAND "${BF3DUMP}" ${ARGN} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 1500)
    if(_rc EQUAL 77 OR _err MATCHES "install not usable")
        message(STATUS "audio_gates: no install: ${_err}")
        cmake_language(EXIT 77)
    endif()
    message(STATUS "bf3dump ${ARGN}: exit ${_rc}")
    if(NOT _rc EQUAL 0)
        message(STATUS "${_out}\n${_err}")
        set(_failed 1)
    endif()
    if(NOT _out MATCHES "install.unchanged yes")
        message(STATUS "  FAIL  install.unchanged")
        set(_failed 1)
    else()
        message(STATUS "  ok    install.unchanged yes")
    endif()
endmacro()

# The line of _out that starts with _prefix.
macro(summary_line _prefix)
    string(REGEX MATCH "${_prefix}[^\n]*" _line "${_out}")
    if(_line STREQUAL "")
        message(STATUS "  FAIL  no summary line '${_prefix}'")
        set(_failed 1)
    else()
        message(STATUS "  ${_line}")
    endif()
endmacro()

# key=value of the summary line compared with _op (EQUAL, LESS_EQUAL, GREATER_EQUAL) against _want.
function(expect _key _op _want)
    string(REGEX MATCH "[ :]${_key}=([-0-9.]+)" _m "${_line}")
    set(_v "${CMAKE_MATCH_1}")
    set(_ok FALSE)
    if(NOT _v STREQUAL "")
        if(_op STREQUAL "EQUAL" AND _v EQUAL _want)
            set(_ok TRUE)
        elseif(_op STREQUAL "LESS_EQUAL" AND NOT _v GREATER _want)
            set(_ok TRUE)
        elseif(_op STREQUAL "GREATER_EQUAL" AND NOT _v LESS _want)
            set(_ok TRUE)
        endif()
    endif()
    if(_ok)
        message(STATUS "  ok    ${_key}=${_v} (${_op} ${_want})")
    else()
        message(STATUS "  FAIL  ${_key}=${_v} (${_op} ${_want})")
        set(_failed 1 PARENT_SCOPE)
    endif()
endfunction()

# Floats: CMake's if() compares integers and floats alike for these magnitudes (math(EXPR) is integer only, so the
# thresholds are written as plain numbers and compared with LESS/GREATER, which accept decimals).

if(GATE STREQUAL "waves")
    run_bf3dump(audio waves MP_Subway TeamDeathMatch0 --decode)
    summary_line("audio waves MP_Subway TeamDeathMatch0:")
    expect(waves EQUAL 909)
    expect(decoded EQUAL 1)
    expect(frame_mismatches EQUAL 0)
    expect(length_mismatches EQUAL 0)
    expect(errors EQUAL 0)
elseif(GATE STREQUAL "loc")
    run_bf3dump(audio loc en --decode)
    summary_line("audio loc en:")
    expect(chunks EQUAL 4290)
    expect(streams EQUAL 15890)
    expect(without_streams EQUAL 7)
    expect(decoded EQUAL 1)
    expect(frame_mismatches EQUAL 0)
    expect(errors EQUAL 0)
elseif(GATE STREQUAL "decode_perf")
    run_bf3dump(audio waves MP_Subway TeamDeathMatch0 --bench 3)
    summary_line("audio decode bench:")
    expect(best_cpu_ms_per_channel_second LESS_EQUAL 0.2)
    string(REGEX MATCH "best_wall_ms_per_channel_second=([0-9.]+)" _w "${_line}")
    message(STATUS "  info  wall ${CMAKE_MATCH_1} ms per channel-second (printed, not gated)")
elseif(GATE STREQUAL "census")
    run_bf3dump(audio census @all-mp)
    summary_line("audio census @all-mp:")
    expect(patches EQUAL 834)
    expect(under_sound EQUAL 833)
    expect(masters EQUAL 1)
    expect(waves EQUAL 1879)
    expect(patch_node_instances EQUAL 32117)
    expect(patch_types EQUAL 46)
    expect(all_node_instances EQUAL 32221)
    expect(all_types EQUAL 58)
    expect(voices EQUAL 7323)
    expect(graphs EQUAL 835)
    expect(compiled EQUAL 835)
    expect(compile_failures EQUAL 0)
    expect(unknown_types EQUAL 0)
    expect(connections EQUAL 9807)
    expect(sen0 EQUAL 9784)
    expect(rou0 EQUAL 23)
    expect(handheld EQUAL 164)
    expect(handheld_types EQUAL 32)
    expect(handheld_set_a2 EQUAL 1)
    expect(handheld_strict EQUAL 164)
    expect(blob_failures EQUAL 0)
elseif(GATE STREQUAL "bank")
    run_bf3dump(audio bank MP_Subway TeamDeathMatch0 --loads 2)
    summary_line("audio bank MP_Subway TeamDeathMatch0:")
    expect(waves EQUAL 909)
    expect(resident_waves EQUAL 629)
    expect(resident_mib LESS_EQUAL 384)
    expect(resident_mib GREATER_EQUAL 265.3)
    expect(resident_mib LESS_EQUAL 265.5)
    expect(skipped_localised EQUAL 280)
    expect(weapon_patches EQUAL 161)
    expect(compiled_strict EQUAL 161)
    expect(named_waves EQUAL 318)
    expect(starved EQUAL 0)
    expect(warm_load_ms LESS_EQUAL 500)
elseif(GATE STREQUAL "m16_offline")
    if(NOT SHOTS)
        message(FATAL_ERROR "audio_gates: m16_offline needs -DSHOTS=<dir>")
    endif()
    run_bf3dump(audio check --g7 --out-dir "${SHOTS}")
    string(REGEX MATCHALL "(PASS|FAIL) [^\n]*" _rows "${_out}")
    foreach(_r IN LISTS _rows)
        message(STATUS "  ${_r}")
    endforeach()
    summary_line("audio check MP_Subway TeamDeathMatch0:")
    expect(rows GREATER_EQUAL 38)
    expect(failed EQUAL 0)
    foreach(_wav m16_offline.wav m16_offline_core.wav m16_offline_noise.wav)
        if(NOT EXISTS "${SHOTS}/${_wav}")
            message(STATUS "  FAIL  ${SHOTS}/${_wav} missing")
            set(_failed 1)
        endif()
    endforeach()
else()
    message(FATAL_ERROR "audio_gates: unknown GATE=${GATE}")
endif()

if(_failed AND NOT REPORT_ONLY)
    message(STATUS "audio gate ${GATE}: FAIL")
    cmake_language(EXIT 1)
endif()
message(STATUS "audio gate ${GATE}: PASS")
