cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(cache "${BUILD_DIR}/godot-cache/${ROW}")
file(REMOVE_RECURSE "${cache}")
file(MAKE_DIRECTORY "${cache}")
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 240 REMOVE_ON_SKIP "${cache}"
    ARGS --path "${PROJECT_DIR}" res://scenes/metro_tdm.tscn -- --bots=0 --quit-after=1 "--bf3-cache=${cache}")
file(REMOVE_RECURSE "${cache}")
if(NOT out MATCHES "(^|\n)Vulkan [0-9][^\n]* - Forward\\+ - Using Device #[0-9]+: ([^\n]*)")
    message(FATAL_ERROR "${ROW}: the engine did not report the Vulkan driver at start")
endif()
message("${ROW}: Vulkan on ${CMAKE_MATCH_2}")
if(NOT out MATCHES "\\[level\\] rendering driver vulkan \\(project: vulkan, fallback to d3d12: off, fallback to opengl3: off\\)")
    message(FATAL_ERROR "${ROW}: the game's rendering line does not name the Vulkan driver")
endif()
if(out MATCHES "SHADER ERROR" OR err MATCHES "SHADER ERROR")
    message(FATAL_ERROR "${ROW}: a shader did not compile on Vulkan")
endif()
if(out MATCHES "exposure effect failed: ([^\n;]*)")
    message(FATAL_ERROR "${ROW}: the exposure compute effect failed on Vulkan: ${CMAKE_MATCH_1}")
endif()
godot_require_pass("\\[level\\] install unchanged: yes")
message("VULKAN: PASS")
