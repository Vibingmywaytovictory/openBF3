cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
set(shots "$ENV{OPENBF3_HUD_SHOTS}")
if(shots STREQUAL "")
    set(shots "${BUILD_DIR}/shots/hud")
endif()
godot_run(SKIP_WITHOUT_INSTALL TIMEOUT 480 ARGS --path "${PROJECT_DIR}" res://scenes/m2a_hud.tscn -- --hud-check "--hud-shots=${shots}")
godot_require_pass("M2A HUD CHECK: PASS")
