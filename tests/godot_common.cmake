set(godot "$ENV{OPENBF3_GODOT}")
if(godot STREQUAL "" AND DEFINED GODOT_EXE AND NOT GODOT_EXE STREQUAL "" AND NOT GODOT_EXE MATCHES "-NOTFOUND$")
	set(godot "${GODOT_EXE}")
endif()
if(godot STREQUAL "" OR NOT EXISTS "${godot}")
	message("SKIPPED: no Godot console executable (OPENBF3_GODOT unset and none found next to the checkout at configure time)")
	cmake_language(EXIT 77)
endif()
if(GODOT_WINDOWED)
	if(NOT "$ENV{OPENBF3_GODOT_WINDOWED}" STREQUAL "1")
		message("SKIPPED: a windowed Godot row; it runs only with OPENBF3_GODOT_WINDOWED=1 (the merge pass's window phase)")
		cmake_language(EXIT 77)
	endif()
	if(NOT "$ENV{OPENBF3_USER_ACTIVE_FLAG}" STREQUAL "" AND EXISTS "$ENV{OPENBF3_USER_ACTIVE_FLAG}")
		message("SKIPPED: the user is active ($ENV{OPENBF3_USER_ACTIVE_FLAG} exists); windowed rows wait for the user-away tenure")
		cmake_language(EXIT 77)
	endif()
endif()
if(NOT EXISTS "${PROJECT_DIR}/.godot/extension_list.cfg")
	file(WRITE "${PROJECT_DIR}/.godot/extension_list.cfg" "res://openbf3.gdextension\n")
endif()
if(NOT DEFINED BUILD_DIR OR BUILD_DIR STREQUAL "")
	message(FATAL_ERROR "a Godot row needs BUILD_DIR: every Godot run gets a scratch settings file under it")
endif()
set(godot_cache_root "")
set(godot_cache_args "")
set(godot_log_args "")
if(NOT GODOT_WINDOWED AND DEFINED ROW AND NOT ROW STREQUAL "")
	set(godot_cache_root "${BUILD_DIR}/godot-cache/${ROW}")
	set(godot_cache_args "--bf3-cache=${godot_cache_root}")
	file(MAKE_DIRECTORY "${godot_cache_root}" "${BUILD_DIR}/godot-logs")
	set(godot_log_args --log-file "${BUILD_DIR}/godot-logs/${ROW}.log")
endif()

function(godot_run)
	cmake_parse_arguments(PARSE_ARGV 0 R "QUIET;SKIP_WITHOUT_INSTALL" "TIMEOUT;HEADER" "ARGS;REMOVE_ON_SKIP;SETTINGS")
	if(R_ARGS MATCHES "--settings-file=")
		message(FATAL_ERROR "${ROW}: godot_run passes the run's --settings-file; a row does not pass its own")
	endif()
	string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef settings_tag)
	set(settings_root "${BUILD_DIR}/scratch/godot-settings-${settings_tag}")
	file(REMOVE_RECURSE "${settings_root}")
	file(MAKE_DIRECTORY "${settings_root}")
	if(R_SETTINGS)
		list(JOIN R_SETTINGS "\n" settings_text)
		file(WRITE "${settings_root}/settings.cfg" "${settings_text}\n")
	endif()
	set(run_args ${R_ARGS})
	if(NOT "--" IN_LIST run_args)
		list(APPEND run_args --)
	endif()
	list(APPEND run_args "--settings-file=${settings_root}/settings.cfg")
	execute_process(
		COMMAND "${godot}" ${run_args}
		TIMEOUT ${R_TIMEOUT}
		RESULT_VARIABLE run_rc
		OUTPUT_VARIABLE run_out
		ERROR_VARIABLE run_err)
	file(REMOVE_RECURSE "${settings_root}")
	if(NOT R_QUIET)
		if(DEFINED R_HEADER)
			message("---- ${R_HEADER} ----")
		endif()
		message("${run_out}")
		if(NOT run_err STREQUAL "")
			message("${run_err}")
		endif()
	endif()
	if(run_out MATCHES "user://settings\\.cfg" OR run_err MATCHES "user://settings\\.cfg")
		message(FATAL_ERROR "${ROW}: the run named user://settings.cfg, the settings every worktree and the owner's play share")
	endif()
	if(run_out MATCHES "data-write journal dropped" OR run_err MATCHES "data-write journal dropped")
		message(FATAL_ERROR "${ROW}: the UI flow data-write journal overflowed its cap")
	endif()
	if(R_SKIP_WITHOUT_INSTALL AND (run_out MATCHES "no usable install" OR run_err MATCHES "no usable install"))
		if(R_REMOVE_ON_SKIP)
			file(REMOVE_RECURSE ${R_REMOVE_ON_SKIP})
		endif()
		message("SKIPPED: no BF3 install found")
		cmake_language(EXIT 77)
	endif()
	set(rc "${run_rc}" PARENT_SCOPE)
	set(out "${run_out}" PARENT_SCOPE)
	set(err "${run_err}" PARENT_SCOPE)
endfunction()

if(GODOT_WINDOWED)
	godot_run(QUIET TIMEOUT 60 ARGS --path "${PROJECT_DIR}" --quit)
	if(NOT rc STREQUAL "0")
		message("${out}")
		message("${err}")
		message("SKIPPED: no window or rendering device (probe exit '${rc}')")
		cmake_language(EXIT 77)
	endif()
endif()

function(godot_require_pass p_pass_regex)
	if(NOT rc STREQUAL "0" OR NOT out MATCHES "${p_pass_regex}")
		message(FATAL_ERROR "${ROW} failed (exit ${rc})${ARGN}")
	endif()
endfunction()
