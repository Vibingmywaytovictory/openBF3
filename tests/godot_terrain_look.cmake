cmake_minimum_required(VERSION 3.29)
set(GODOT_WINDOWED TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/godot_common.cmake)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef tag)
set(root "${BUILD_DIR}/scratch/godot-terrain-look-${tag}")
file(MAKE_DIRECTORY "${BUILD_DIR}/scratch")
if("$ENV{OPENBF3_TERRAIN_SHOTS}" STREQUAL "")
    set(shots "${BUILD_DIR}/scratch/godot-terrain-look-shots-${tag}")
    set(keep_shots FALSE)
else()
    file(TO_CMAKE_PATH "$ENV{OPENBF3_TERRAIN_SHOTS}" shots)
    set(keep_shots TRUE)
endif()
file(MAKE_DIRECTORY "${shots}")
if(NOT DEFINED LEVEL)
    set(LEVEL MP_007)
endif()
if(NOT DEFINED MODE)
    set(MODE ConquestLarge0)
endif()
if(NOT DEFINED VIEWS)
    set(VIEWS "hill@-700,230,300,90,-25")
endif()
set(look_args "")
if(DEFINED LOOK_OFF)
    set(look_args "--look-off=${LOOK_OFF}")
endif()
set(gradient_floor 500)
set(list "")
foreach(view IN LISTS VIEWS)
    string(REPLACE "@" ".png@" view "${view}")
    list(APPEND list "${shots}/${LEVEL}_${view}")
endforeach()
list(JOIN list "\;" views)
godot_run(QUIET SKIP_WITHOUT_INSTALL TIMEOUT 300 REMOVE_ON_SKIP "${root}"
    ARGS --path "${PROJECT_DIR}" res://scenes/m1_metro.tscn -- "--level=${LEVEL}" "--mode=${MODE}" "--bf3-cache=${root}" --no-hud --shot-settle=3 --shot-measure=120
        "--shots=${views}" --shot-detail ${look_args} --quit-after=1)
string(REGEX MATCHALL "\\[m1\\] shot detail [^\n]*" details "${out}")
set(failed FALSE)
list(LENGTH details n)
list(LENGTH list want)
if(NOT rc STREQUAL "0" OR NOT n EQUAL want)
    message("${out}")
    message("${err}")
    message("godot.terrain_look: exit ${rc}, ${n} of ${want} shots measured")
    set(failed TRUE)
endif()
string(REGEX MATCHALL "\\[look\\] frame time median at [^\n]*" frames "${out}")
foreach(line IN LISTS frames)
    message("${line}")
endforeach()
foreach(line IN LISTS details)
    message("${line}")
    string(REGEX MATCH "gradient ([0-9]+)\\.([0-9]+) / 255, chroma spread ([0-9]+)\\.([0-9]+)" m "${line}")
    if(NOT m)
        set(failed TRUE)
        continue()
    endif()
    string(SUBSTRING "${CMAKE_MATCH_2}00" 0 2 gf)
    math(EXPR gradient "${CMAKE_MATCH_1} * 100 + ${gf}")
    if(gradient LESS gradient_floor)
        message("godot.terrain_look: ${line} is under the gradient floor of ${gradient_floor} hundredths: the terrain draws one flat colour")
        set(failed TRUE)
    endif()
endforeach()
file(REMOVE_RECURSE "${root}")
if(NOT keep_shots)
    file(REMOVE_RECURSE "${shots}")
else()
    message("shots: ${shots}")
endif()
if(failed)
    message(FATAL_ERROR "godot.terrain_look: FAIL")
endif()
message("godot.terrain_look: PASS")
